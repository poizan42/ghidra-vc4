	is (Vaop=2 & $(VA264)) ...
	   & vargd & varga & vargb & vflags & vpmask & valu80imm & Vimm16 {
    local en:2 = vpmask;
    local dbase:4 = 0x8000 + (VdHi * 0x400:4) + (VdLo * 4:4) + 2:4;
    local abase:4 = 0x8000 + (VaHi * 0x400:4) + (VaLo * 4:4) + 2:4;
    local bscalar:4 = sext(Vimm16);
@repeat L 0 8
    vln2683(dbase, abase, en, $[1*L]:2, $[64*L]:4, $[128*L]:4);
@endrepeat
@repeat L 0 8
    vln2758(dbase, bscalar, en, $[8+1*L]:2, $[512+64*L]:4);
@endrepeat
  }

  # v32interh wc5 dHaV
  :v32interh vargd, varga, vargb^vflags
	is (Vaop=5 & $(VA290)) ...
	   & vargd & varga & vargb & vflags & vpmask & valu80imm & Vimm16 {
    local en:2 = vpmask;
    local abase:4 = 0x8000 + (VaHi * 0x400:4) + (VaLo * 4:4) + 2:4;
    local bscalar:4 = sext(Vimm16);
    vln2682(VdRow[16,16], abase, en, 0:2, 0x200:4);
    vln2757(VdRow[48,16], bscalar, en, 1:2);
    vln2682(VdRow[80,16], abase, en, 2:2, 0x240:4);
    vln2757(VdRow[112,16], bscalar, en, 3:2);
    vln2682(VdRow[144,16], abase, en, 4:2, 0x280:4);
    vln2757(VdRow[176,16], bscalar, en, 5:2);
    vln2682(VdRow[208,16], abase, en, 6:2, 0x2c0:4);
    vln2757(VdRow[240,16], bscalar, en, 7:2);
    vln2682(VdRow[272,16], abase, en, 8:2, 0x300:4);
    vln2757(VdRow[304,16], bscalar, en, 9:2);
    vln2682(VdRow[336,16], abase, en, 10:2, 0x340:4);
    vln2757(VdRow[368,16], bscalar, en, 11:2);
    vln2682(VdRow[400,16], abase, en, 12:2, 0x380:4);
    vln2757(VdRow[432,16], bscalar, en, 13:2);
    vln2682(VdRow[464,16], abase, en, 14:2, 0x3c0:4);
    vln2757(VdRow[496,16], bscalar, en, 15:2);
  }

  # v32interh wc5 dVaH
  :v32interh vargd, varga, vargb^vflags
	is (Vaop=5 & $(VA291)) ...
	   & vargd & varga & vargb & vflags & vpmask & valu80imm & Vimm16 {
    local en:2 = vpmask;
    local dbase:4 = 0x8000 + (VdHi * 0x400:4) + (VdLo * 4:4) + 2:4;
    local bscalar:4 = sext(Vimm16);
    vln1159(dbase, varow[272,16], en, 0:2, 0x0:4);
    vln2758(dbase, bscalar, en, 1:2, 0x40:4);
    vln1159(dbase, varow[304,16], en, 2:2, 0x80:4);
    vln2758(dbase, bscalar, en, 3:2, 0xc0:4);
    vln1159(dbase, varow[336,16], en, 4:2, 0x100:4);
    vln2758(dbase, bscalar, en, 5:2, 0x140:4);
    vln1159(dbase, varow[368,16], en, 6:2, 0x180:4);
    vln2758(dbase, bscalar, en, 7:2, 0x1c0:4);
    vln1159(dbase, varow[400,16], en, 8:2, 0x200:4);
    vln2758(dbase, bscalar, en, 9:2, 0x240:4);
    vln1159(dbase, varow[432,16], en, 10:2, 0x280:4);
    vln2758(dbase, bscalar, en, 11:2, 0x2c0:4);
    vln1159(dbase, varow[464,16], en, 12:2, 0x300:4);
    vln2758(dbase, bscalar, en, 13:2, 0x340:4);
    vln1159(dbase, varow[496,16], en, 14:2, 0x380:4);
    vln2758(dbase, bscalar, en, 15:2, 0x3c0:4);
  }

