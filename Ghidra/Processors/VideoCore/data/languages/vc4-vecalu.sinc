  # bitplanes with the destination absent (Vseld=7) and SETF: flags only.
  # Vsetf48=1 and Vseld=7 are what make this the flag-setting idiom rather than a
  # value-producing bitplanes; the general form keeps its pcodeop.
  :v^Vawidth^"bitplanes" vargd, vargb^vflags
	is (Vaop=1 & Vawidth & Vdir=0 & Vseld=7 & Vsetf48=1
	    & Vhasimm=0 & Vselb=7 & VRm) ... & vargd & vargb & vflags {
    # Lane L's result is all-ones iff bit L of B is set, so Z is the complement of the
    # mask and N is the mask itself. Sixteen lanes, two assignments.
    local mask:2 = VRm[0,16];
    VFN = mask;
    local inv:2 = ~mask;
    VFZ = inv;
  }

  # v16add, destination absent (Vseld=7) with SETF: flags only, widthcode 0.
  :v16add vargd, varga, vargb^vflags
	is (Vaop=32 & Vawidth=0 & Vdir=0 & Vseld=7 & Vsetf48=1 & Vselb=0 & Vhasimm=0 & vbrow & Vsela=0 & Vhasoffa=0 & varow) ...
	   & vargd & varga & vargb & vflags {
    local c:2 = 0;
    local z:2 = 0;
    local n:2 = 0;
    vln521(c, z, n, varow[0,8], vbrow[0,8], 0:2);
    vln521(c, z, n, varow[32,8], vbrow[32,8], 1:2);
    vln521(c, z, n, varow[64,8], vbrow[64,8], 2:2);
    vln521(c, z, n, varow[96,8], vbrow[96,8], 3:2);
    vln521(c, z, n, varow[128,8], vbrow[128,8], 4:2);
    vln521(c, z, n, varow[160,8], vbrow[160,8], 5:2);
    vln521(c, z, n, varow[192,8], vbrow[192,8], 6:2);
    vln521(c, z, n, varow[224,8], vbrow[224,8], 7:2);
    vln521(c, z, n, varow[256,8], vbrow[256,8], 8:2);
    vln521(c, z, n, varow[288,8], vbrow[288,8], 9:2);
    vln521(c, z, n, varow[320,8], vbrow[320,8], 10:2);
    vln521(c, z, n, varow[352,8], vbrow[352,8], 11:2);
    vln521(c, z, n, varow[384,8], vbrow[384,8], 12:2);
    vln521(c, z, n, varow[416,8], vbrow[416,8], 13:2);
    vln521(c, z, n, varow[448,8], vbrow[448,8], 14:2);
    vln521(c, z, n, varow[480,8], vbrow[480,8], 15:2);
    VFZ = z;
    VFN = n;
    VFC = c;
  }

  # v16add, destination absent (Vseld=7) with SETF: flags only, widthcode 1.
  :v16add vargd, varga, vargb^vflags
	is (Vaop=32 & Vawidth=0 & Vdir=0 & Vseld=7 & Vsetf48=1 & Vselb=1 & Vhasimm=0 & vbrow & Vsela=1 & Vhasoffa=0 & varow) ...
	   & vargd & varga & vargb & vflags {
    local c:2 = 0;
    local z:2 = 0;
    local n:2 = 0;
    vln521(c, z, n, varow[8,8], vbrow[8,8], 0:2);
    vln521(c, z, n, varow[40,8], vbrow[40,8], 1:2);
    vln521(c, z, n, varow[72,8], vbrow[72,8], 2:2);
