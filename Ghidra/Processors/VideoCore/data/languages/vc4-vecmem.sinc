with : Vop=0x3c ... {

  # v8ld with a 8-bit register element at byte-in-lane 0
  :v8ld vargd, vmemargb^vflags
	is (Vmop=0 & Vmwidth=0 & Vdir=0 & Vseld=0 & Vsetf48=0
	    & Vhasimm=0 & Vselb=7 & VRm & VdRow & Vhasoffd=0) ... & vargd & vmemargb & vflags {
    local base:4 = VRm;
    VdRow[0,8] = *:1 (base);
@repeat L 0 15
    VdRow[$[32+32*L],8] = *:1 (base + $[1+1*L]:4);
@endrepeat
  }

  # v8ld with a 8-bit register element at byte-in-lane 1
  :v8ld vargd, vmemargb^vflags
	is (Vmop=0 & Vmwidth=0 & Vdir=0 & Vseld=1 & Vsetf48=0
	    & Vhasimm=0 & Vselb=7 & VRm & VdRow & Vhasoffd=0) ... & vargd & vmemargb & vflags {
    local base:4 = VRm;
    VdRow[8,8] = *:1 (base);
@repeat L 0 15
    VdRow[$[40+32*L],8] = *:1 (base + $[1+1*L]:4);
@endrepeat
  }

  # v8ld with a 8-bit register element at byte-in-lane 2
  :v8ld vargd, vmemargb^vflags
	is (Vmop=0 & Vmwidth=0 & Vdir=0 & Vseld=2 & Vsetf48=0
	    & Vhasimm=0 & Vselb=7 & VRm & VdRow & Vhasoffd=0) ... & vargd & vmemargb & vflags {
    local base:4 = VRm;
    VdRow[16,8] = *:1 (base);
@repeat L 0 15
    VdRow[$[48+32*L],8] = *:1 (base + $[1+1*L]:4);
@endrepeat
  }

  # v8ld with a 8-bit register element at byte-in-lane 3
  :v8ld vargd, vmemargb^vflags
	is (Vmop=0 & Vmwidth=0 & Vdir=0 & Vseld=3 & Vsetf48=0
	    & Vhasimm=0 & Vselb=7 & VRm & VdRow & Vhasoffd=0) ... & vargd & vmemargb & vflags {
    local base:4 = VRm;
    VdRow[24,8] = *:1 (base);
@repeat L 0 15
    VdRow[$[56+32*L],8] = *:1 (base + $[1+1*L]:4);
@endrepeat
