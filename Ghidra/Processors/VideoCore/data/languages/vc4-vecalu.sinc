    VdRow[288,16] = srcB[128,16];
    VdRow[320,16] = srcA[160,16];
    VdRow[352,16] = srcB[160,16];
    VdRow[384,16] = srcA[192,16];
    VdRow[416,16] = srcB[192,16];
    VdRow[448,16] = srcA[224,16];
    VdRow[480,16] = srcB[224,16];
  }

  # v16odd
  :v16odd vargd, varga, vargb^vflags
	is (Vaop=3 & Vawidth=0 & Vdir=0 & Vseld=4 & Vselb=4 & Vsetf48=0 & Vhasimm=0 & Vhasoffd=0 & VdRow & vbrow & Vsela=4 & Vhasoffa=0 & varow) ...
	   & vargd & varga & vargb & vflags {
    local srcA:64 = varow;
    local srcB:64 = vbrow;
    VdRow[0,16] = srcA[32,16];
    VdRow[32,16] = srcA[96,16];
    VdRow[64,16] = srcA[160,16];
    VdRow[96,16] = srcA[224,16];
    VdRow[128,16] = srcA[288,16];
    VdRow[160,16] = srcA[352,16];
    VdRow[192,16] = srcA[416,16];
    VdRow[224,16] = srcA[480,16];
    VdRow[256,16] = srcB[32,16];
    VdRow[288,16] = srcB[96,16];
    VdRow[320,16] = srcB[160,16];
    VdRow[352,16] = srcB[224,16];
    VdRow[384,16] = srcB[288,16];
    VdRow[416,16] = srcB[352,16];
    VdRow[448,16] = srcB[416,16];
    VdRow[480,16] = srcB[480,16];
  }
}
