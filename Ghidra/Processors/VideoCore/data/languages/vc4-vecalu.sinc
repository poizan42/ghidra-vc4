@define VA378 "Vawidth=0 & Vdir=0 & Vseld=4 & Vsela=4 & Vselb=4 & Vsetf48=0 & Vhasimm=0 & Vhasoffd=0 & Vhasoffa=0 & VdRow & varow & vbrow"
@define VA379 "Vawidth=1 & Vdir=0 & Vseld=6 & Vsela=6 & Vselb=6 & Vsetf48=0 & Vhasimm=0 & Vhasoffd=0 & Vhasoffa=0 & VdRow & varow & vbrow"
# Generated by vpu-sem/gen-alu.py -- do not edit by hand.
#
# REQUIRES THE FORK'S SLEIGH. The per-lane bodies are written once inside an `@repeat` block and
# unrolled by the preprocessor, which halves this file. `@repeat` is not stock SLEIGH syntax --
# it lives in ghidra-vc4's SleighPreprocessor -- so this .sinc will not compile against an
# upstream Ghidra. See vpu-sem/repeat.py and vpu-sem/outlined/README.md.
#
# Vector ALU operations at BOTH element widths, with all three operands at the widthcode
# matching the mnemonic -- `v16op HX(d,0),HX(a,0),HX(b,0)` and `v32op HY(...)`, exactly the
# two shapes that were probed. Every function here was
# identified by matching candidate semantics against 16 hardware samples per operation;
# see vpu-sem/alu-probe.py and vpu-probe/findings-alu.md. The generator's header lists what
# is deliberately left as a pcodeop and why.
#
# THE THREE ABSENT-DESTINATION FAMILIES cover every one of those operations, not a subset of
# them: SETF (the lane flags are the result), the SRU (a reduction into a scalar register) and
# the accumulator (sixteen 32-bit lanes of VACC). All three sit DOWNSTREAM OF THE ALU, which was
# measured rather than assumed for each, so their form of any modelled operation is measured too.
# The saturating operations are the one exclusion, and it is a measurement gap rather than a
# volume decision -- see the note at the end of this file.
#
# READING THE PER-CONSTRUCTOR COMMENTS. They carry the identifying facts only, because the
# prose used to be repeated verbatim on thousands of them -- 858 KB of an 8 MB file:
#   `v16add wc0 dVaHbH`  widthcode 0; destination vertical, both sources horizontal. A V
#                        operand's element k is lane Lo of row (Hi*16 + k); an H operand's
#                        element k is lane k of one row.
#   `v16add setf wc4`    destination absent (Vseld=7) with SETF -- the flags ARE the result.
#   `v16add sru SUMS wc4` destination absent, and the SRU reduces the result of that
#                        operation over the sixteen lanes into a scalar register.

# Saturating clamp, stored once per (wide, element, destination element). See emit_sat_macros
# in vpu-sem/gen-alu.py. dst arrives holding the in-range value; only the clamped cases are
# overridden. Comparisons are signed: the intermediates are all sign-extended.
outlined macro vsatfix_4_2_1(dst, wide) {
  local hi:1 = wide s> 0xff:4;
  local lo:1 = wide s< 0:4;
  local ok:1 = !hi && !lo;
  dst = (dst * zext(ok)) + (0xff:2 * zext(hi)) + (0:2 * zext(lo));
}
outlined macro vsatfix_4_2_2(dst, wide) {
  local hi:1 = wide s> 0x7fff:4;
  local lo:1 = wide s< 0xffff8000:4;
  local ok:1 = !hi && !lo;
  dst = (dst * zext(ok)) + (0x7fff:2 * zext(hi)) + (0x8000:2 * zext(lo));
}
outlined macro vsatfix_8_4_1(dst, wide) {
  local hi:1 = wide s> 0xff:8;
  local lo:1 = wide s< 0:8;
  local ok:1 = !hi && !lo;
  dst = (dst * zext(ok)) + (0xff:4 * zext(hi)) + (0:4 * zext(lo));
}
outlined macro vsatfix_8_4_2(dst, wide) {
  local hi:1 = wide s> 0x7fff:8;
  local lo:1 = wide s< 0xffffffffffff8000:8;
  local ok:1 = !hi && !lo;
  dst = (dst * zext(ok)) + (0x7fff:4 * zext(hi)) + (0x8000:4 * zext(lo));
}
outlined macro vsatfix_8_4_4(dst, wide) {
  local hi:1 = wide s> 0x7fffffff:8;
  local lo:1 = wide s< 0xffffffff80000000:8;
  local ok:1 = !hi && !lo;
  dst = (dst * zext(ok)) + (0x7fffffff:4 * zext(hi)) + (0x80000000:4 * zext(lo));
}

# Predicated per-lane write, stored once. See emit_pred_macros in vpu-sem/gen-alu.py.
# dst is the destination element, nv the new value, en the 16-bit enable mask, lane the index.
# Branch-free select: a disabled lane writes its old value back, which for an ALU op is
# indistinguishable from not writing it. The complement uses XOR at the element size because
# `!x` yields one byte whatever x is.
outlined macro vpredwrite1(dst, nv, en, lane) {
  local eb:2 = (en >> lane) & 1;
  local e:1 = eb:1;
  local i:1 = e ^ 1:1;
  dst = (nv * e) + (dst * i);
}
outlined macro vpredwrite2(dst, nv, en, lane) {
  local e:2 = (en >> lane) & 1;
  local i:2 = e ^ 1:2;
  dst = (nv * e) + (dst * i);
}
outlined macro vpredwrite4(dst, nv, en, lane) {
  local e:4 = zext((en >> lane) & 1);
  local i:4 = e ^ 1:4;
  dst = (nv * e) + (dst * i);
}

# Unpredicated 80-bit ALU with no SRU and no auto-increment, for the flags-only SETF family.
# Vpredm and Vsru live in the vecaux token, so they cannot be constrained in a vec48 `&` group;
# this is the same trick valu80 uses.
# The SOURCE row offsets are pinned absent (15 encodes "none"): a real offset there makes the
# accessed row Vd + rN, chosen at run time, which these bodies do not model. VRoffd is
# deliberately NOT pinned -- this family's destination is absent (Vseld=7), so the field is a
# don't-care, and gas leaves it at 0 rather than 15. Pinning it excluded the flag-setters the
# conformance recordings use and took hw-carryflag from agree=8 back to agree=2/unmodelled=6.
vsetfu: is Vopsize=1 ; (Vpredm=0 & Vsru=0 & Vincd=0 & Vinca=0 & Vincb=0
                        & VRoffa=15 & VRoffb=15) { }

# One subtable per SRU function. The function has to be in the PATTERN rather than read as a
# value, because each one is a different reduction; the destination register is an operand, so
# eight registers cost one constructor rather than eight. Same pin set as valu80. Which of
# start.elf's SRU sites that reaches is not asserted here any more -- vpu-sem/sru-sites.py
# recomputes it over a real image and attributes every site it misses to the pin that rejects it.

# One subtable per accumulator code. Same pin set as the SRU family, and VRoffd is likewise
# NOT pinned: the destination is absent, so it is a don't-care that gas leaves at 0.
vacc0: " UACC" is Vopsize=1 ; (Vpredm=0 & VsruSel=0 & VaccEna=1 & VaccWba=1
        & VaccSub=0 & VaccClra=0 & VaccSign=0 & VaccHigh=0
        & Vincd=0 & Vinca=0 & Vincb=0 & VRoffa=15 & VRoffb=15) { }
vacc1: " SACC" is Vopsize=1 ; (Vpredm=0 & VsruSel=0 & VaccEna=1 & VaccWba=1
        & VaccSub=0 & VaccClra=0 & VaccSign=1 & VaccHigh=0
        & Vincd=0 & Vinca=0 & Vincb=0 & VRoffa=15 & VRoffb=15) { }
vacc2: " CLRA UACC" is Vopsize=1 ; (Vpredm=0 & VsruSel=0 & VaccEna=1 & VaccWba=1
        & VaccSub=0 & VaccClra=1 & VaccSign=0 & VaccHigh=0
        & Vincd=0 & Vinca=0 & Vincb=0 & VRoffa=15 & VRoffb=15) { }
vacc3: " CLRA SACC" is Vopsize=1 ; (Vpredm=0 & VsruSel=0 & VaccEna=1 & VaccWba=1
        & VaccSub=0 & VaccClra=1 & VaccSign=1 & VaccHigh=0
        & Vincd=0 & Vinca=0 & Vincb=0 & VRoffa=15 & VRoffb=15) { }
vacc4: " UACCH" is Vopsize=1 ; (Vpredm=0 & VsruSel=0 & VaccEna=1 & VaccWba=1
        & VaccSub=0 & VaccClra=0 & VaccSign=0 & VaccHigh=1
        & Vincd=0 & Vinca=0 & Vincb=0 & VRoffa=15 & VRoffb=15) { }
vacc5: " SACCH" is Vopsize=1 ; (Vpredm=0 & VsruSel=0 & VaccEna=1 & VaccWba=1
        & VaccSub=0 & VaccClra=0 & VaccSign=1 & VaccHigh=1
        & Vincd=0 & Vinca=0 & Vincb=0 & VRoffa=15 & VRoffb=15) { }
vacc6: " CLRA UACCH" is Vopsize=1 ; (Vpredm=0 & VsruSel=0 & VaccEna=1 & VaccWba=1
        & VaccSub=0 & VaccClra=1 & VaccSign=0 & VaccHigh=1
        & Vincd=0 & Vinca=0 & Vincb=0 & VRoffa=15 & VRoffb=15) { }
vacc7: " CLRA SACCH" is Vopsize=1 ; (Vpredm=0 & VsruSel=0 & VaccEna=1 & VaccWba=1
        & VaccSub=0 & VaccClra=1 & VaccSign=1 & VaccHigh=1
        & Vincd=0 & Vinca=0 & Vincb=0 & VRoffa=15 & VRoffb=15) { }
vacc8: " UDEC" is Vopsize=1 ; (Vpredm=0 & VsruSel=0 & VaccEna=1 & VaccWba=1
        & VaccSub=1 & VaccClra=0 & VaccSign=0 & VaccHigh=0
        & Vincd=0 & Vinca=0 & Vincb=0 & VRoffa=15 & VRoffb=15) { }
vacc9: " SDEC" is Vopsize=1 ; (Vpredm=0 & VsruSel=0 & VaccEna=1 & VaccWba=1
        & VaccSub=1 & VaccClra=0 & VaccSign=1 & VaccHigh=0
        & Vincd=0 & Vinca=0 & Vincb=0 & VRoffa=15 & VRoffb=15) { }
vacc10: " CLRA UDEC" is Vopsize=1 ; (Vpredm=0 & VsruSel=0 & VaccEna=1 & VaccWba=1
        & VaccSub=1 & VaccClra=1 & VaccSign=0 & VaccHigh=0
        & Vincd=0 & Vinca=0 & Vincb=0 & VRoffa=15 & VRoffb=15) { }
vacc11: " CLRA SDEC" is Vopsize=1 ; (Vpredm=0 & VsruSel=0 & VaccEna=1 & VaccWba=1
        & VaccSub=1 & VaccClra=1 & VaccSign=1 & VaccHigh=0
        & Vincd=0 & Vinca=0 & Vincb=0 & VRoffa=15 & VRoffb=15) { }
vacc12: " UDECH" is Vopsize=1 ; (Vpredm=0 & VsruSel=0 & VaccEna=1 & VaccWba=1
        & VaccSub=1 & VaccClra=0 & VaccSign=0 & VaccHigh=1
        & Vincd=0 & Vinca=0 & Vincb=0 & VRoffa=15 & VRoffb=15) { }
vacc13: " SDECH" is Vopsize=1 ; (Vpredm=0 & VsruSel=0 & VaccEna=1 & VaccWba=1
        & VaccSub=1 & VaccClra=0 & VaccSign=1 & VaccHigh=1
        & Vincd=0 & Vinca=0 & Vincb=0 & VRoffa=15 & VRoffb=15) { }
vacc14: " CLRA UDECH" is Vopsize=1 ; (Vpredm=0 & VsruSel=0 & VaccEna=1 & VaccWba=1
        & VaccSub=1 & VaccClra=1 & VaccSign=0 & VaccHigh=1
        & Vincd=0 & Vinca=0 & Vincb=0 & VRoffa=15 & VRoffb=15) { }
vacc15: " CLRA SDECH" is Vopsize=1 ; (Vpredm=0 & VsruSel=0 & VaccEna=1 & VaccWba=1
        & VaccSub=1 & VaccClra=1 & VaccSign=1 & VaccHigh=1
        & Vincd=0 & Vinca=0 & Vincb=0 & VRoffa=15 & VRoffb=15) { }
vaccnw: Vsru is Vopsize=1 ; (Vpredm=0 & VsruSel=0 & VaccEna=1 & VaccWba=0 & VaccClra=0
        & Vsru & Vincd=0 & Vinca=0 & Vincb=0 & VRoffa=15 & VRoffb=15) { }

vsru0: " SUMU "^VsruReg is Vopsize=1 ; (Vpredm=0 & VsruSel=1 & VsruFn=0
        & VsruReg & Vincd=0 & Vinca=0 & Vincb=0 & VRoffa=15 & VRoffb=15)
        { export VsruReg; }   # sum of zero-extended elements, wrapping
vsru1: " SUMS "^VsruReg is Vopsize=1 ; (Vpredm=0 & VsruSel=1 & VsruFn=1
        & VsruReg & Vincd=0 & Vinca=0 & Vincb=0 & VRoffa=15 & VRoffb=15)
        { export VsruReg; }   # sum of sign-extended elements, saturating
vsru2: " MAX2 "^VsruReg is Vopsize=1 ; (Vpredm=0 & VsruSel=1 & VsruFn=2
