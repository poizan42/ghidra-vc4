	is (Vaop=32 & Vawidth=0 & Vdir=0 & Vseld=7 & Vsetf48=1 & Vselb=0 & Vhasimm=0 & vbrow & Vsela=0 & Vhasoffa=0 & varow) ...
	   & vargd & varga & vargb & vflags {
    local c:2 = 0;
    local z:2 = 0;
    local n:2 = 0;
    vln211(c, z, n, varow[0,8], vbrow[0,8], 0:2);
    vln211(c, z, n, varow[32,8], vbrow[32,8], 1:2);
    vln211(c, z, n, varow[64,8], vbrow[64,8], 2:2);
