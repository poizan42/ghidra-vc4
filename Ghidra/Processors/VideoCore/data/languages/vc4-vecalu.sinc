        & VsruReg & Vincd=0 & Vinca=0 & Vincb=0 & VRoffa=15 & VRoffb=15)
        { export VsruReg; }   # index of the signed minimum
vsru4: " MAX4 "^VsruReg is Vopsize=1 ; (Vpredm=0 & VsruSel=1 & VsruFn=4
        & VsruReg & Vincd=0 & Vinca=0 & Vincb=0 & VRoffa=15 & VRoffb=15)
        { export VsruReg; }   # measured identical to MAX
