# The B-operand row. Vb = (VbHi << 4) | VbLo across two non-contiguous fields, so as with
# varow it cannot be an `attach variables` target and the 64 rows are enumerated.
vbrow: is VbHi=0 & VbLo=0 { export VR0; }
vbrow: is VbHi=0 & VbLo=1 { export VR1; }
vbrow: is VbHi=0 & VbLo=2 { export VR2; }
vbrow: is VbHi=0 & VbLo=3 { export VR3; }
vbrow: is VbHi=0 & VbLo=4 { export VR4; }
