	is (Vaop=24 & $(VA45)) ...
	   & vargd & varga & vargb & vflags {
    local dbase:4 = 0x8000 + (VdHi * 0x400:4) + (VdLo * 4:4) + 3:4;
    local abase:4 = 0x8000 + (VaHi * 0x400:4) + (VaLo * 4:4) + 3:4;
    local bbase:4 = 0x8000 + (VbHi * 0x400:4) + (VbLo * 4:4) + 3:4;
@repeat L 0 16
    vln411(dbase, abase, bbase, $[64*L]:4);
@endrepeat
  }

  # v32mov wc3 dVbV
  :v32mov vargd, vargb^vflags
	is (Vaop=0 & Vawidth=1 & Vseld=3 & Vhasoffd=0 & Vdir=1 & VdHi & VdLo & Vselb=3 & Vhasimm=0 & Vsetf48=0 & VbHi & VbLo) ...
	   & vargd & vargb & vflags {
    local dbase:4 = 0x8000 + (VdHi * 0x400:4) + (VdLo * 4:4) + 3:4;
    local bbase:4 = 0x8000 + (VbHi * 0x400:4) + (VbLo * 4:4) + 3:4;
@repeat L 0 16
    vln412(dbase, bbase, $[64*L]:4);
@endrepeat
  }

