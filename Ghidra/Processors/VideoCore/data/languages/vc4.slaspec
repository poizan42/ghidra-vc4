# sleigh specification file for Broadcom VideoCore IV

## TODO:
## - vector ALU semantics (only the mnemonics are known -- nothing measured yet)
## - the V direction, the vector-B address forms, and the accumulator-indexed gather/scatter

## The vector register file IS modelled (VR0..VR63, VACC below), and the H-direction loads and
## stores with a scalar base have real p-code in vc4-vecmem.sinc. Every other vector constructor
## is a `define pcodeop` black box rather than `unimpl`, so the decompiler still walks through
## vector code instead of stopping at the first instruction of it: on a sample of 14 small
## functions containing vector instructions, that took the count decompiling without
## "Truncating control flow" from 1/14 to 14/14. Hardware
## measurements that constrain what they do are recorded as comments next to the relevant
## constructors -- see the block above "# Vector memory ops", and the note on the PCTL
## `mov` pair. They come from running payloads on a Pi 4 VPU via the mailbox EXECUTE_CODE
## tag; the method, the failed hypotheses and the controls are in vpu-probe/ in the
## rpi-hacking repo. Everything still unverified is labelled as such rather than guessed, and
## vpu-sem/ re-runs the modelled ones against silicon so the distinction cannot rot.
##
## The encoding side of this spec has been cross-checked against those measurements and
## against a CGEN description of the same ISA, and was correct in every particular that
## could be tested: the widthcode/offset tables, widthcode 7 meaning an absent operand,
## Vselb=7 selecting a scalar B, Vhasimm selecting an immediate B, and Vrep (including
## value 7 = "REP r0") existing only in the 80-bit forms.

define endian=little;
define alignment=2;

define space ram type=ram_space size=4 default;
define space register type=register_space size=4;

# General registers
define register offset=0 size=4 [
	r0 r1 r2 r3 r4 r5 r6 r7 r8 r9 r10 r11 r12 r13 r14 r15
	r16 r17 r18 r19 r20 r21 r22 r23 gp sp lr r27 r28 r29 sr pc ];

# Status register fields
@define SR_U  "sr[31,1]"
@define SR_I  "sr[30,1]"
@define SR_S  "sr[29,1]"
@define SR_CB "sr[ 4,2]"
@define SR_Z  "sr[ 3,1]"
@define SR_N  "sr[ 2,1]"
@define SR_C  "sr[ 1,1]"
@define SR_V  "sr[ 0,1]"

# Flags as registers to improve decompiler output
define register offset=0x100 size=1 [ Z N C V ];

# Processor control registers
@define PCTL_REG_BASE "0x200"
define register offset=$(PCTL_REG_BASE) size=4 [
	p0 p1 p2 p3 p4 p5 p6 p7 p8 p9 p10 p11 p12 p13 p14 p15
	p16 p17 p18 p19 p20 p21 p22 p23 p24 p25 p26 p27 p28 p29 p30 p31 ];


################################################################
# Context
################################################################

define register offset=0x2000 size=4 contextreg;

# Vector register file: P(64,64) -- 64 rows of 64 bytes. A row is 16 lanes x 4 bytes, and an
# element of width w at index i lives at byte 4*i (lane-major), which is why a vector load is a
# series of stride-4 assignments rather than a block move.
define register offset=0x8000 size=64 [
  VR0  VR1  VR2  VR3  VR4  VR5  VR6  VR7  VR8  VR9  VR10 VR11 VR12 VR13 VR14 VR15
  VR16 VR17 VR18 VR19 VR20 VR21 VR22 VR23 VR24 VR25 VR26 VR27 VR28 VR29 VR30 VR31
  VR32 VR33 VR34 VR35 VR36 VR37 VR38 VR39 VR40 VR41 VR42 VR43 VR44 VR45 VR46 VR47
  VR48 VR49 VR50 VR51 VR52 VR53 VR54 VR55 VR56 VR57 VR58 VR59 VR60 VR61 VR62 VR63 ];

# Per-lane accumulator, the index source for lookupml/indexwriteml (measured -- see
# vpu-probe/findings-lookup.md). 16 lanes x 32 bits.
#
# The "UACC writes the low half, UACCH the high" that used to stand here was loose. MEASURED since,
# on the monitor: UACC is `acc += operand` and UACCH is `acc += operand << 16` -- an addition of a
# SHIFTED operand, not a write into a separate half. `v32mov -,HY(20,0) UACCH` on a seed of L+1 gave
# (0x0010 + L) << 16 | (L + 1), with the seed still in the low halfword. See findings-alu.md, "The
# accumulator branch, MEASURED". The accumulator ops are not modelled yet; the SRU half of Vsru is.
define register offset=0x9000 size=64 [ VACC ];

# Per-lane vector condition flags: bit L is lane L's flag, so one 16-bit register per condition.
# MEASURED (findings-alu.md): predication is a genuine per-lane predicate; the flags carry both a
# zero and a sign bit; the sign is that of the ELEMENT, not of a wider intermediate; and IFZ/IFNN
# are exact complements of IFNZ/IFN. Confirmed by setting the flags with `mov` -- already measured
# to compute b -- over a row staged with known zero, positive and negative values, then reading
# them back through a conditional move: all four conditions matched predictions made before the run.
# VFC is the per-lane carry: unsigned carry out of the top bit, measured 2026-07-27 (see the note on
# vpmask). It is read by IFC/IFNC and written by `add`-SETF; no other operation's carry has been
# measured, so nothing else writes it yet.
define register offset=0x9100 size=2 [ VFZ VFN VFC ];

define context contextreg
  # common fields
  chkcc    = (28,31)	# condition code to be checked

  # load/store
  ldstop   = ( 0, 2)	# load/store operation

  # ALU
  aluop    = ( 0, 5)	# ALU operation (full)

  # ldm/stm
  storesp  = (21,21)	# stm: save resulting sp?
  loadsp   = (20,20)	# ldm: restore sp at end?
  loadpc   = (19,19)	# ldm: make a jump?
  mspoff   = (11,18)	# ldm/stm: memory offset of the sp register
  mregidx  = ( 6,10)	# ldm/stm: current register
  mcount   = ( 0, 5)	# ldm/stm: remaining number of registers
;

################################################################
# Tokens
################################################################

define token opword(16)
  Op16    = ( 0,15)
  op11    = ( 5,15)
  Op8     = ( 8,15)
  Op7     = ( 9,15)
  Rr      = ( 5, 9)
  Sbit6   = (10,10)
  Uoff5   = ( 4, 8)
  OpAux   = ( 5, 7)
  Rbase2  = ( 8, 9)
  Pd      = ( 0, 4)
  Rd      = ( 0, 4)

  # conditional branches
  Cc      = ( 7,10)
  Off7    = ( 0, 6) signed

  # ldm/stm
  Op9     = ( 7,15)
  Rmbase  = ( 5, 6)
  Count   = ( 0, 4)
  Rd6     = ( 0, 4)
  Rd16    = ( 0, 4)
  Rd24    = ( 0, 4)

  # sp-relative addressing
  Off6    = ( 5,10) signed

  # load/store
  LdStOp    = ( 5, 7)
  # load/store with 12-bit offset
  Off12Sign = ( 8, 8)
  LdStOpLo  = ( 8,10)

  # instruction using RdLo and RrLo
  RrLo  = ( 4, 7)
  RdLo  = ( 0, 3)
    # 32-bit load/store with base and aligned offset
    Op4     = (12,15)
    Uoff4   = ( 8,11)
    # 16-bit ALU instructions
    Op3     = (13,15)
      # ALU with register
      AluLo = ( 8,12)
      # ALU with 5-bit unsigned immediate
      Alu4  = ( 9,12)
      Imm5  = ( 4, 8)

  # ALU with immediate
  Op6     = (10,15)
  Alu5    = ( 5, 9)

  # triadic ALU
  Op5     = (11,15)
  Alu6    = ( 5,10)
    # scaled addition/subtraction
    ScAdd = ( 5, 6)
    ScSub = ( 5, 8)
;

define token argword (16)
  # common fields
  Ra        = (11,15)

  # all conditional instructions
  CcSfx     = ( 7,10)

  # argument B
  argHasImm = ( 6, 6)
  argBit5   = ( 5, 5)
  Rb        = ( 0, 4)
  argImm6   = ( 0, 5) signed

  # load/store with 12-bit offset
  argOff11  = ( 0,10) signed
  argUoff11 = ( 0,10)

  # move to/from control registers
  argOp11   = ( 5,15)
  Pb        = ( 0, 4)
;

define token opdword(32)
  # common fields
  dwOp4    = (12,15)

  # all conditional instructions
  dwCc     = ( 8,11)

  # branches
  dwLink    = ( 7, 7)

  # conditional branches
  dwOff23Hi = ( 0, 6) signed
  dwOff23Lo = (16,31)

  # branch and link
  dwOff27Hi  = ( 8,11) signed
  dwOff27Mid = ( 0, 6)
  dwOff27Lo  = (16,31)

  # loop instructions
  dwImmA    = ( 4, 7) signed
  dwRa      = ( 4, 7)
  dwRd      = ( 0, 3)
  dwHasImmB = (31,31)
  dwHasImmA = (30,30)
  # with register B
  dwRb      = (26,29)
  dwOff10   = (16,25) signed
  # with immediate B
  dwImmB    = (24,29)
  dwOff8    = (16,23) signed
;

define token arg16(16)
  Imm16   = ( 0,15) signed
  Sbit16  = (15,15)
;

define token arg32(32)
  Imm32   = ( 0,31)
  Imm27   = ( 0,26) signed
  Sbit27  = (26,26)
  Rbase   = (27,31)
;

define token vec48(48)
  # common fields
  Vop      = (10,15)
  Vopsize  = (11,11) # 48-bit or 80-bit instructions
  VRoff    = ( 0, 2)
  Vbased   = (29,31)
  Vseld    = (29,31)
  VseldHi  = (30,31)
  Vdir     = (28,28)
  Vd       = (22,27)
  VdRow    = (22,27)   # same bits as Vd; attached to VRF rows for semantics only
  VdHi     = (26,27)
  VdLo     = (22,25)
  Vbasea   = (19,21)
  Vsela    = (19,21)
  VselaHi  = (20,21)
  Vhasoffa = (18,18)
  VaHi     = (16,17)
  VaLo     = (44,47)
  Vhasoffd = (43,43)
  Vhasimm  = (42,42)
  Vbaseb   = (39,41)
  Vselb    = (39,41)
  VselbHi  = (40,41)
  Vpred48  = (39,41)
  Vhasoffb = (38,38)
  Vsetf48  = (38,38)
  Vb       = (32,37)
  VbHi     = (36,37)
  VbLo     = (32,35)
  Vimm6    = (32,37) signed
  VRm      = (32,36)	# doc says 6 bits, but there are only 32 regs?

  # memory operations
  Vmop     = ( 5, 9)
  Vmwidth  = ( 3, 4)

  # ALU operations
  Vawidth  = ( 9, 9)
  Vaop     = ( 3, 8)

  # 80-bit instructions
  Vsetf80  = (43,43)
  Vimm16Lo = (32,41)
  Vdird    = (28,28)
  Vdira    = (18,18)
  Vdirb    = (38,38)
  Vrep     = ( 0, 2)
  VmoffLo  = (32,38)
;

define token vecaux(32)
  # common fields
  VRoffd   = (12,15)
  Vincd    = (11,11)
  Vcboffd  = (10,10)
  VRoffa   = ( 6, 9)
  Vinca    = ( 5, 5)
  Vcboffa  = ( 4, 4)
  Vrowa    = ( 0, 3)
  Vpred80  = (29,31)
  Vpredm   = (29,31)   # semantic twin of Vpred80: same bits, so it adds no constraint
  Vsru     = (22,28)
  # Vsru is a TAGGED UNION (measured, findings-alu.md). Bit 6 set selects the scalar reduction
  # unit: bits 3-5 are the function and bits 0-2 the destination register r0..r7. Bit 6 clear with
  # ENA set is the accumulator branch, whose bits binutils names SRU 0x40 / ENA 0x20 / HIGH 0x10 /
  # SIGN 0x08 / CLRA 0x04 / WBA 0x02 / SUB 0x01 (cpu/vc4.opc:36-42). Sub-fields so the reduction
  # forms can be matched and their destination register named as an operand.
  VsruSel  = (28,28)
  VsruFn   = (25,27)
  VsruReg  = (22,24)
  # The other branch of the same union: bit 6 clear with ENA set is an ACCUMULATOR op. One named
  # field per bit, because each is a separate measured behaviour (findings-alu.md): CLRA clears
  # before the op, WBA gates whether the accumulator is written at all, SUB picks the direction,
  # SIGN picks sign- vs zero-extension of a result narrower than the 32-bit lane, HIGH shifts the
  # result left by 16. Names and positions from cpu/vc4.opc:36-42.
  VaccEna  = (27,27)
  VaccHigh = (26,26)
  VaccSign = (25,25)
  VaccClra = (24,24)
  VaccWba  = (23,23)
  VaccSub  = (22,22)

  # vector addressing
  VRoffb   = (18,21)
  Vincb    = (17,17)
  Vcboffb  = (16,16)

  # immediate value
  Vimm16Hi = (16,21) signed

  # register-relative addressing
  VmoffHi  = (22,28) signed
  VRmbase  = (18,21)
  VmoffMid = (16,17)
;

attach variables [ Rd Ra Rb Rr Rbase VRm ] [
	r0 r1 r2 r3 r4 r5 r6 r7 r8 r9 r10 r11 r12 r13 r14 r15
	r16 r17 r18 r19 r20 r21 r22 r23 gp sp lr r27 r28 r29 sr pc ];

attach variables [ RdLo RrLo dwRa dwRb dwRd VRoffd VRoffa VRoffb VRmbase ] [
	r0 r1 r2 r3 r4 r5 r6 r7 r8 r9 r10 r11 r12 r13 r14 r15 ];

attach variables [ VRoff ] [
	r0 r1 r2 r3 r4 r5 r6 r7 ];

# Base register for ldm/stm
attach variables [ Rmbase ] [ r0 r6 r16 gp ];

# Base register for ld/st with 16-bit offset
attach variables [ Rbase2 ] [ gp sp pc r0 ];

# last register for ldm/stm depends on first register
attach variables [ Rd6 ] [
	r6 r7 r8 r9 r10 r11 r12 r13 r14 r15 r16 r17 r18 r19 r20 r21
	r22 r23 gp sp lr r27 r28 r29 sr pc r0 r1 r2 r3 r4 r5 ];
attach variables [ Rd16 ] [
	r16 r17 r18 r19 r20 r21 r22 r23 gp sp lr r27 r28 r29 sr pc
	r0 r1 r2 r3 r4 r5 r6 r7 r8 r9 r10 r11 r12 r13 r14 r15 ];
attach variables [ Rd24 ] [
	gp sp lr r27 r28 r29 sr pc r0 r1 r2 r3 r4 r5 r6 r7
	r8 r9 r10 r11 r12 r13 r14 r15 r16 r17 r18 r19 r20 r21 r22 r23 ];

attach variables [ VdRow ]
[
  VR0  VR1  VR2  VR3  VR4  VR5  VR6  VR7  VR8  VR9  VR10 VR11 VR12 VR13 VR14 VR15
  VR16 VR17 VR18 VR19 VR20 VR21 VR22 VR23 VR24 VR25 VR26 VR27 VR28 VR29 VR30 VR31
  VR32 VR33 VR34 VR35 VR36 VR37 VR38 VR39 VR40 VR41 VR42 VR43 VR44 VR45 VR46 VR47
  VR48 VR49 VR50 VR51 VR52 VR53 VR54 VR55 VR56 VR57 VR58 VR59 VR60 VR61 VR62 VR63
];

attach variables [ Pd Pb ] [
	p0 p1 p2 p3 p4 p5 p6 p7 p8 p9 p10 p11 p12 p13 p14 p15
	p16 p17 p18 p19 p20 p21 p22 p23 p24 p25 p26 p27 p28 p29 p30 p31 ];

attach names [ Cc CcSfx dwCc ] [
  "eq" "ne" "cs" "cc" "mi" "pl" "vs" "vc"
  "hi" "ls" "ge" "lt" "gt" "le" ""   "f" ];

attach names [ Vmwidth ] [
  "8" "16" "32" "unk"
];

attach names [ Vawidth ] [ "16" "32" ];

attach names [ Vdir Vdird Vdira Vdirb ] [ "H" "V" ];
attach names [ Vincd Vinca Vincb ] [ "" "++" ];
attach names [ Vcboffd Vcboffa Vcboffb ] [ "" "*" ];

attach names [ Vrep ] [
  "" " REP2" " REP4" " REP8" " REP16" " REP32" " REP64" " REP r0"
];

attach names [ Vsetf48 Vsetf80 ] [
  "" " SETF"
];

attach names [ Vpred48 Vpred80 ] [
  "" " NV" " IFZ" " IFNZ" " IFN" " IFNN" " IFC" " IFNC"
];

attach names [ Vsru ] [
  "" " sru001" " sru002" " sru003"
  " sru004" " sru005" " (clra)" " sru007"
  " sru008" " sru009" " sru010" " sru011"
  " sru012" " sru013" " sru014" " sru015"
  " sru016" " sru017" " sru018" " sru019"
  " sru020" " sru021" " sru022" " sru023"
  " sru024" " sru025" " sru026" " sru027"
  " sru028" " sru029" " sru030" " sru031"
  " UADD" " USUB" " UACC" " UDEC"
  " CLRA" " CLRA USUB" " CLRA UACC" " CLRA UDEC"
  " SADD" " SSUB" " SACC" " SDEC"
  " CLRA SADD" " CLRA SSUB" " CLRA SACC" " CLRA SDEC"
  " UADDH" " USUBH" " UACCH" " UDECH"
  " CLRA UADDH" " CLRA USUBH" " CLRA UACCH" " CLRA UDECH"
  " SADDH" " SSUBH" " SACCH" " SDECH"
  " CLRA SADDH" " CLRA SSUBH" " CLRA SACCH" " CLRA SDECH"
  " SUMU r0" " SUMU r1" " SUMU r2" " SUMU r3"
  " SUMU r4" " SUMU r5" " SUMU r6" " SUMU r7"
  " SUMS r0" " SUMS r1" " SUMS r2" " SUMS r3"
  " SUMS r4" " SUMS r5" " SUMS r6" " SUMS r7"
  " MAX2 r0" " MAX2 r1" " MAX2 r2" " MAX2 r3"
  " MAX2 r4" " MAX2 r5" " MAX2 r6" " MAX2 r7"
  " IMIN r0" " IMIN r1" " IMIN r2" " IMIN r3"
  " IMIN r4" " IMIN r5" " IMIN r6" " IMIN r7"
  " MAX4 r0" " MAX4 r1" " MAX4 r2" " MAX4 r3"
  " MAX4 r4" " MAX4 r5" " MAX4 r6" " MAX4 r7"
  " IMAX r0" " IMAX r1" " IMAX r2" " IMAX r3"
  " IMAX r4" " IMAX r5" " IMAX r6" " IMAX r7"
  " MAX6 r0" " MAX6 r1" " MAX6 r2" " MAX6 r3"
  " MAX6 r4" " MAX6 r5" " MAX6 r6" " MAX6 r7"
  " MAX r0" " MAX r1" " MAX r2" " MAX r3"
  " MAX r4" " MAX r5" " MAX r6" " MAX r7"
];

# The SRU's destination is r0..r7 -- three bits, measured: every probe in the batch changed exactly
# the register the mnemonic named and nothing else.
attach variables [ VsruReg ] [ r0 r1 r2 r3 r4 r5 r6 r7 ];

attach values [ Vbased Vbasea Vbaseb ] [ 0 16 32 48 0 32 0 _ ];

################################################################
# Macros
################################################################

macro pack_sr()
{
  $(SR_Z) = Z;
  $(SR_N) = N;
  $(SR_C) = C;
  $(SR_V) = V;
}

macro unpack_sr()
{
  Z = $(SR_Z);
  N = $(SR_N);
  C = $(SR_C);
  V = $(SR_V);
}

macro push(val) {
  sp = sp - 4;
  *[ram]:4 sp = val;
}

macro pop(val) {
  val = *[ram]:4 sp;
  sp = sp + 4;
}

macro pop_pc() {
  local tmp:4;
  pop(tmp);
  return [tmp];
}

################################################################
# Memory Offset
################################################################

with memoff12: {
  : +argUoff11 is Off12Sign=0 ; argUoff11
	{ local tmp:4 = argUoff11; export tmp; }
  :  argOff11  is Off12Sign=1 ; argOff11
	{ local tmp:4 = argOff11; export tmp; }
  :           is Off12Sign=0 ; argOff11=0
	{ local tmp:4 = 0; export tmp; }
}

with memoff16: {
  : +Imm16 is Sbit16=0 & Imm16
	{ local tmp:4 = Imm16; export tmp; }
  :  Imm16 is Sbit16=1 & Imm16
	{ local tmp:4 = Imm16; export tmp; }
  :        is Sbit16=0 & Imm16=0
	{ local tmp:4 = 0; export tmp; }
}

with memoff27: {
  : +Imm27 is Sbit27=0 & Imm27
	{ local tmp:4 = Imm27; export tmp; }
  :  Imm27 is Sbit27=1 & Imm27
	{ local tmp:4 = Imm27; export tmp; }
  :        is Sbit27=0 & Imm27=0
	{ local tmp:4 = 0; export tmp; }
}

with spoff5: {
  : sp+off is Uoff5 & sp [ off = Uoff5 << 2; ]
	{ local tmp:4 = sp + off; export tmp; }
  : sp is Uoff5=0 & sp
	{ export sp; }
}

with spoff6: {
  : sp+off is Sbit6=0 & Off6 & sp [ off = Off6 << 2; ]
	{ local tmp:4 = sp + off; export tmp; }
  : sp^off is Sbit6=1 & Off6 & sp [ off = Off6 << 2; ]
	{ local tmp:4 = sp + off; export tmp; }
  : sp     is Sbit6=0 & Off6=0 & sp
	{ export sp; }
}

################################################################
# Memory Locations
################################################################

rel7: reloc is Off7 [ reloc = inst_start + (Off7 << 1); ]
	{ export *:4 reloc; }
rel8: reloc is dwOff8 [ reloc = inst_start + (dwOff8 << 1); ]
	{ export *:4 reloc; }
rel10: reloc is dwOff10 [ reloc = inst_start + (dwOff10 << 1); ]
	{ export *:4 reloc; }
rel16: reloc is Imm16 [ reloc = inst_start + Imm16; ]
	{ export *:4 reloc; }
rel23: reloc is dwOff23Hi & dwOff23Lo
	[ reloc = inst_start + (dwOff23Hi << 17 | dwOff23Lo << 1); ]
	{ export *:4 reloc; }
rel27: reloc is dwOff27Hi & dwOff27Mid & dwOff27Lo
	[ reloc = inst_start +
		(dwOff27Hi << 24 | dwOff27Mid << 17 | dwOff27Lo << 1); ]
	{ export *:4 reloc; }
rel32: reloc is Imm32 [ reloc = inst_start + Imm32; ]
	{ export *:4 reloc; }

abs32: Imm32 is Imm32 { export *:4 Imm32; }

################################################################
# Condition codes
################################################################

with chkcond: {
  : is chkcc=0  { local tmp:1 = Z; export tmp; }	# eq
  : is chkcc=1  { local tmp:1 = !Z; export tmp; }	# ne
  : is chkcc=2  { local tmp:1 = C; export tmp; }	# cs / lo
  : is chkcc=3  { local tmp:1 = !C; export tmp; }	# cc / hs
  : is chkcc=4  { local tmp:1 = N; export tmp; }	# mi
  : is chkcc=5  { local tmp:1 = !N; export tmp; }	# pl
  : is chkcc=6  { local tmp:1 = V; export tmp; }	# vs
  : is chkcc=7  { local tmp:1 = !V; export tmp; }	# vc
  : is chkcc=8  { local tmp:1 = !C && !Z; export tmp; }	# hi
  : is chkcc=9  { local tmp:1 =  C ||  Z; export tmp; }	# ls
  : is chkcc=10 { local tmp:1 = (N == V); export tmp; }	# ge
  : is chkcc=11 { local tmp:1 = (N != V); export tmp; }	# lt
  : is chkcc=12 { local tmp:1 = (N == V) && !Z; export tmp; }	# gt
  : is chkcc=13 { local tmp:1 = (N != V) ||  Z; export tmp; }	# le
  : is chkcc=14 { local tmp:1 = 1; export tmp; }
  : is chkcc=15 { local tmp:1 = 0; export tmp; }
}

# Conditional instructions
ccsfx: is epsilon ... {}
cond: is epsilon ... {}
with : (Op5=0x18 | Op7=0x50 | Op7=0x52 | Op6=0x32) ... {
  ccsfx: "."^CcSfx is (Op16 ; CcSfx) {}
  cond:  "."^CcSfx is (Op16 ; CcSfx) & chkcond [ chkcc = CcSfx; ]
	{ if (!chkcond) goto inst_next; }

  ccsfx: is Op16 ; CcSfx=14 {}
  cond:  is Op16 ; CcSfx=14 {}
}

################################################################
# System instructions
################################################################

define pcodeop swi;
macro exception(num) {
  local tmp:1 = num;
  local intloc:4 = swi(tmp);
  call [intloc];
}

# MEASURED 2026-08-07: the vector is 0x0d. It was 0x0e here until then, and this comment used to
# explain at length why that number could not be trusted; it is kept short now because the question
# is closed. Three independent strands agree:
#
#  1. Direct measurement. The bare-metal monitor gives every one of the 128 exception vectors its own
#     `bl exc_handler` stub, so the handler recovers the number from `lr` and prints it. A `00 00`
#     probe reports `EXC! cf010402 20000008 cf003ff8 0000000d cec00c7c` -- vector 0x0d.
#     (`../../../../../vpu-monitor/logs/stage3-allones.txt`; the `..excpc*.txt` sessions repeat it.)
#  2. The firmware's own table. plans/exception-handling.md deduced 0x0d structurally before it was
#     measured: 0x0d is the only architectural vector whose handler is a bare `nop; rti`, which is
#     exactly what makes the bkpt-at-handler-entry debugging idiom work.
#  3. Survivability, from the other direction (#113). A `bkpt` over the mailbox EXECUTE_CODE path is
#     completely survivable -- the harness completes, no register changes, the mailbox keeps working
#     -- which is only possible because 0x0d's handler returns immediately. An 0x0e trap would have
#     landed in the catch-all bucket, whose handler does not return.
#
# The refuted source was Hermitage's videocoreiv.arch:106, `"; bkpt"  # provisional: raises exception
# 0x0e`, which its own author marked provisional and which was the sole authority for both the
# mnemonic and the number. The marker was dropped in transcription here (`:sleep` below kept its);
# that omission is what let a guess read as a fact for two months. The MNEMONIC is still
# single-sourced -- only the number has been measured.
#
# Independently established by flow analysis: bkpt is used DELIBERATELY, not just as how 0x0000
# padding renders. In start.elf, 81 isolated bkpt instructions are reached by fall-through inside a
# function, most in the assert idiom -- a conditional branch over the trap:
#     beq  <after>
#     bkpt              <- taken only when the assertion fails
#   <after>:
# So flow termination here was already right when the vector number was not.
:bkpt is Op16=0x0000
	{ exception(0x0d); }
:nop is Op16=0x0001 {}

define pcodeop version;
:version Rd is op11=0x007 & Rd
	{ Rd = version(); }

:sleep is Op16=0x0002
	{ }	# provisional

# Both directions confirmed on hardware, 2026-07-26: `mov r6,p0` assembles to 26 cc 00 00,
# i.e. word0 = 0xcc00 | (OpAux << 5) | Rd and word1 = Pb, exactly as modelled here. Read on a
# Pi 4 under running firmware, one register per EXECUTE_CODE call, p0..p31 return
# p0=8, p10=3, p15=7 and zero everywhere else.
#
# HAZARDS, all observed rather than inferred:
#  - Reading p17 hard-wedges the VPU and takes the firmware with it. Reproduced 3/3.
#  - Reading p16 wedged once in three attempts, so it is unreliable rather than fatal.
#    (An earlier note here blamed p16 for the reproducible wedge; that was a misattribution
#    from a batch run in which the failing probe was mislabelled. p17 is the reliable one.)
#  - Reads are NOT freely composable: a single probe reading p12,p13,p14,p15,p16,p18 in
#    sequence wedged, although every one of those registers reads fine on its own.
#  - p18..p31 do not carry a stable value. From a fresh boot the first execution reads 0 and
#    every execution after it reads 1, whatever the probe contains -- a nop does it. So it is
#    a once-per-boot latch, not a counter and not tied to any instruction class. Two of them
#    read in one probe gave 1 then 0, so they neither alias nor hold independent state.
#
# The write direction (mov Pd,Rb) is untested and is a better way to break the board than to
# learn from it.
#
# Worth knowing when cross-referencing with binutils: gas cannot express either form. Its
# CGEN description defines the register file (h-preg in cpu/vc4.cpu) but no instruction
# references it, so `mov r6,p0` silently mis-assembles as `mov r6,0x0`. This spec is the
# only place these instructions exist.
:mov Pd, Rb is Op8=0xcc & OpAux=0 & Pd ; argOp11=0 & Rb
	{ Pd = Rb; }
:mov Rd, Pb is Op8=0xcc & OpAux=1 & Rd ; argOp11=0 & Pb
	{ Rd = Pb; }

:user is Op16=0x0003 {
  $(SR_U) = 1;
}

define pcodeop irq_enable;
:ei is Op16=0x0004 {
  $(SR_I) = 1;
  irq_enable();
}

define pcodeop irq_disable;
:di is Op16=0x0005 {
  $(SR_I) = 0;
  irq_disable();
}

:cbclr is Op16=0x0006 {
  $(SR_CB) = 0;
}
:cbadd1 is Op16=0x0007 {
  $(SR_CB) = $(SR_CB) + 1;
}
:cbadd2 is Op16=0x0008 {
  $(SR_CB) = $(SR_CB) + 2;
}
:cbadd3 is Op16=0x0009 {
  $(SR_CB) = $(SR_CB) + 3;
}

:rti is Op16=0x000a {
  local new_sr:4;
  local new_pc:4;
  pop(new_sr);
  pop(new_pc);
  sr = new_sr;
  unpack_sr();
  return [new_pc];
}

:swi Rd is op11=0x001 & Rd {
  exception(0x20 + (Rd:1 & 0x1f));
}

:swi Count is op11=0x00e & Count
	{ exception(0x20 + Count); }
# FIXME: is this merely an alias for the previous instruction ???
:swi num is op11=0x00f & Count [ num = Count + 32; ]
	{ exception(0x20 + Count); }

# 0000 0000 110d dddd ".short 0x%04x{0x00c0+d} ; mov unknown_reg, r%i{d}"

# 0000 0001 010d dddd ".short 0x%04x{0x0140+d} ; r%i{d}"
# 0000 0001 011d dddd ".short 0x%04x{0x0160+d} ; r%i{d}"
# 0000 0001 10dd dddd ".short 0x%04x{0x0180+d} ; r%i{d}"

################################################################
# Branch Instructions
################################################################

:b rel32 is Op16=0xe100 ; rel32
	{ goto rel32; }

:j abs32 is Op16=0xe000 ; abs32
	{ goto abs32; }

with : op11=0x002 {
  :b Rd is Rd {
    goto [Rd];
  }
  :rts is Rd=26 {
    return [lr];
  }
}

:bl Rd is op11=0x003 & Rd {
  lr = inst_next;
  call [Rd];
}

:bl rel27 is dwOp4=0x9 & dwLink=1 & rel27 {
  lr = inst_next;
  call rel27;
}

:bl rel32 is Op16=0xe300 ; rel32 {
  lr = inst_next;
  call rel32;
}

:jl abs32 is Op16=0xe200 ; abs32 {
  lr = inst_next;
  call abs32;
}

# Table/Switch instructions

# branch using indirect byte displacement  b *(pc+rd)
:switch.b Rd is op11=0x004 & Rd {
  local tbl:4 = inst_next;
  local val:1 = *(tbl + Rd);
  local target:4 = inst_next + (sext(val) << 1);
  goto [target];
}

:switch Rd is op11=0x005 & Rd {
  local tbl:4 = inst_next;
  local val:2 = *(tbl + (Rd << 1));
  local target:4 = inst_next + (sext(val) << 1);
  goto [target];
}

# Conditional Branches
# Make a separate constructor for unconditional branches using the
# "true" condition to mark these instructions as UNCONDITIONAL_JUMP.
with : Op5=0x03 {
  :b^Cc rel7 is Cc & rel7 & chkcond [ chkcc = Cc; ]
	{ if (chkcond) goto rel7; }
  :b rel7 is Cc=14 & rel7
	{ goto rel7; }
}
with : dwOp4=0x9 & dwLink=0 {
  :b^dwCc rel23 is dwCc & rel23 & chkcond [ chkcc = dwCc; ]
	{ if (chkcond) goto rel23; }
  :b rel23 is dwCc=14 & rel23
	{ goto rel23; }
}

################################################################
# Loop Instructions
################################################################

loopinc: dwRa   is dwHasImmA=0 & dwRa   { export dwRa; }
loopinc: dwImmA is dwHasImmA=1 & dwImmA
	{ local tmp:4 = dwImmA; export tmp; }

loopend: dwRb   is dwHasImmB=0 & dwRb    { export dwRb; }
loopend: dwImmB is dwHasImmB=1 & dwImmB
	{ local tmp:4 = dwImmB; export tmp; }

disploopend: dwRb   is dwHasImmB=0 & dwRb    {}
disploopend: dwImmB is dwHasImmB=1 & dwImmB  {}

looprel: rel10 is dwHasImmB=0 & rel10 { export rel10; }
looprel: rel8  is dwHasImmB=1 & rel8  { export rel8; }

with loopchkcond: {
  : is dwCc=0 & dwRd & loopend		# eq
	{ local tmp:1 = (dwRd == loopend); export tmp; }
  : is dwCc=1 & dwRd & loopend		# ne
	{ local tmp:1 = (dwRd != loopend); export tmp; }
  : is dwCc=2 & dwRd & loopend		# cs / lo
	{ local tmp:1 = (dwRd < loopend); export tmp; }
  : is dwCc=3 & dwRd & loopend		# cc / hs
	{ local tmp:1 = (dwRd >= loopend); export tmp; }
  : is dwCc=4 & dwRd & loopend		# mi
	{ local tmp:1 = (dwRd - loopend) s< 0; export tmp; }
  : is dwCc=5 & dwRd & loopend		# pl
	{ local tmp:1 = (dwRd - loopend) s>= 0; export tmp; }
  : is dwCc=6 & dwRd & loopend		# vs
	{ local tmp:1 = sborrow(dwRd, loopend); export tmp; }
  : is dwCc=7 & dwRd & loopend		# vc
	{ local tmp:1 = !sborrow(dwRd, loopend); export tmp; }
  : is dwCc=8 & dwRd & loopend		# hi
	{ local tmp:1 = (dwRd > loopend); export tmp; }
  : is dwCc=9 & dwRd & loopend		# ls
	{ local tmp:1 = (dwRd <= loopend); export tmp; }
  : is dwCc=10 & dwRd & loopend		# ge
	{ local tmp:1 = (dwRd s>= loopend); export tmp; }
  : is dwCc=11 & dwRd & loopend		# lt
	{ local tmp:1 = (dwRd s< loopend); export tmp; }
  : is dwCc=12 & dwRd & loopend		# gt
	{ local tmp:1 = (dwRd s> loopend); export tmp; }
  : is dwCc=13 & dwRd & loopend		# le
	{ local tmp:1 = (dwRd s<= loopend); export tmp; }
  : is dwCc=14				# t
	{ local tmp:1 = 1; export tmp; }
  : is dwCc=15				# f
	{ local tmp:1 = 0; export tmp; }
}

loopcond: dwCc is dwCc & loopchkcond { export loopchkcond; }

with : dwOp4=0x8 {
  :addcmpb^loopcond dwRd, loopinc, disploopend, looprel
	is loopcond & dwRd & loopinc & disploopend & looprel {
    dwRd = dwRd + loopinc;
    build loopcond;
    if (loopcond)
      goto looprel;
  }
  :b^loopcond dwRd, disploopend, looprel
	is loopcond & dwRd & dwHasImmA=1 & dwImmA=0 & disploopend & looprel {
    if (loopcond)
      goto looprel;
  }
}

################################################################
# Stack-relative and PC-relative Addressing
################################################################

:lea Rd, rel16 is op11=0x5ff & Rd ; rel16
	{ Rd = &rel16; }

:lea Rd, rel32 is op11=0x728 & Rd ; rel32
	{ Rd = &rel32; }

with : Op5=0x02 {
  :lea Rd, (spoff6) is Rd & spoff6
	{ Rd = spoff6; }
  :add sp, off is Rd=25 & sp & Off6
	[ off = Off6 << 2; ]
	{ sp = sp + off; }
}

################################################################
# Stack Manipulation Instructions
################################################################

# Register index to register mapping
with mreg: {
  : r0  is r0  & mregidx=0  { export r0; }
  : r1  is r1  & mregidx=1  { export r1; }
  : r2  is r2  & mregidx=2  { export r2; }
  : r3  is r3  & mregidx=3  { export r3; }
  : r4  is r4  & mregidx=4  { export r4; }
  : r5  is r5  & mregidx=5  { export r5; }
  : r6  is r6  & mregidx=6  { export r6; }
  : r7  is r7  & mregidx=7  { export r7; }
  : r8  is r8  & mregidx=8  { export r8; }
  : r9  is r9  & mregidx=9  { export r9; }
  : r10 is r10 & mregidx=10 { export r10; }
  : r11 is r11 & mregidx=11 { export r11; }
  : r12 is r12 & mregidx=12 { export r12; }
  : r13 is r13 & mregidx=13 { export r13; }
  : r14 is r14 & mregidx=14 { export r14; }
  : r15 is r15 & mregidx=15 { export r15; }
  : r16 is r16 & mregidx=16 { export r16; }
  : r17 is r17 & mregidx=17 { export r17; }
  : r18 is r18 & mregidx=18 { export r18; }
  : r19 is r19 & mregidx=19 { export r19; }
  : r20 is r20 & mregidx=20 { export r20; }
  : r21 is r21 & mregidx=21 { export r21; }
  : r22 is r22 & mregidx=22 { export r22; }
  : r23 is r23 & mregidx=23 { export r23; }
  : gp  is gp  & mregidx=24 { export gp; }
  : sp  is sp  & mregidx=25 { export sp; }
  : lr  is lr  & mregidx=26 { export lr; }
  : r27 is r27 & mregidx=27 { export r27; }
  : r28 is r28 & mregidx=28 { export r28; }
  : r29 is r29 & mregidx=29 { export r29; }
  : sr  is sr  & mregidx=30 { export sr; }
  : pc  is pc  & mregidx=31 { export pc; }
}

with mendreg: {
  : Rd   is Rmbase=0 & Rd   { export Rd; }
  : Rd6  is Rmbase=1 & Rd6  { export Rd6; }
  : Rd16 is Rmbase=2 & Rd16 { export Rd16; }
  : Rd24 is Rmbase=3 & Rd24 { export Rd24; }
}

with stm_tail: {
  : is storesp=0          {}
  : is storesp=1 & mspoff { *(sp + mspoff) = sp; }
}

with stm_body: {
  : is mcount=0 & stm_tail { build stm_tail; }
  with : mcount!=0
  {
    : is mregidx!=24 & mreg & stm_body
	[ mregidx = mregidx + 1; mcount = mcount - 1; ]
	{ push(mreg); build stm_body; }
    : is mregidx=24 & stm_body
	[ mregidx = 25; mcount = mcount - 1;
	  mspoff = mcount * 4; storesp = 1; ]
	{ sp = sp - 4; build stm_body; }
  }
}

with stm_start: {
  : is Rmbase=0 & Count & stm_body
	[ mcount = Count + 1; mregidx =  0 - 1; ] {}
  : is Rmbase=1 & Count & stm_body
	[ mcount = Count + 1; mregidx =  6 - 1; ] {}
  : is Rmbase=2 & Count & stm_body
	[ mcount = Count + 1; mregidx = 16 - 1; ] {}
  : is Rmbase=3 & Count & stm_body
	[ mcount = Count + 1; mregidx = 24 - 1; ] {}
}

with ldm_tail: {
  : is loadsp=0 & loadpc=0
	{}
  : is loadsp=0 & loadpc=1
	{ pop_pc(); }
  : is loadsp=1 & loadpc=0 & mspoff
	{ sp = *(sp - mspoff); }
  : is loadsp=1 & loadpc=1 & mspoff
	{ pop(pc); sp = *(sp - mspoff); return [pc]; }
}

with ldm_body: {
  : is mcount=0 & ldm_tail { build ldm_tail; }
  with : mcount!=0
  {
    : is mregidx!=26 & mregidx!=31 & mreg & ldm_body
	[ mregidx = mregidx - 1; mcount = mcount - 1; ]
	{ pop(mreg); build ldm_body; }
    : is mregidx=26 & ldm_body
	[ mspoff = (mcount + loadpc) * 4; loadsp = 1;
	  mregidx = 25; mcount = mcount - 1; ]
	{ sp = sp + 4; build ldm_body; }
    : is mregidx=31 & ldm_body
	[ mregidx = 30; mcount = mcount - 1; ]
	{ pop(sr); unpack_sr(); build ldm_body; }
  }
}

with ldm_start: {
  : is Rmbase=0 & Count & ldm_body
	[ mcount = Count + 1; mregidx =  0 + mcount; ] {}
  : is Rmbase=1 & Count & ldm_body
	[ mcount = Count + 1; mregidx =  6 + mcount; ] {}
  : is Rmbase=2 & Count & ldm_body
	[ mcount = Count + 1; mregidx = 16 + mcount; ] {}
  : is Rmbase=3 & Count & ldm_body
	[ mcount = Count + 1; mregidx = 24 + mcount; ] {}
}

stm_lr:      is Op9=0x05      & stm_start
	{ build stm_start; }
stm_lr: , lr is Op9=0x07 & lr & stm_start
	{ push(lr); build stm_start; }

ldm_pc:      is Op9=0x04      & ldm_start [ loadpc = 0; ]
	{ build ldm_start; }
ldm_pc: , pc is Op9=0x06 & pc & ldm_start [ loadpc = 1; ]
	{ build ldm_start; }

:stm Rmbase-mendreg^stm_lr, ("--sp") is Rmbase & mendreg & stm_lr
	{ build stm_lr; }
:ldm Rmbase-mendreg^ldm_pc, ("sp++") is Rmbase & mendreg & ldm_pc
	{ build ldm_pc; }

# Omit range if only one register is stored
:stm Rmbase^stm_lr, ("--sp") is Rmbase & Count=0 & stm_lr
	{ build stm_lr; }
:ldm Rmbase^ldm_pc, ("sp++") is Rmbase & Count=0 & ldm_pc
	{ build ldm_pc; }

# If count is 31 and lr/pc is stored/loaded, then no registers
# but lr/pc are stored/loaded
:stm lr, ("--sp") is Op9=0x07 & Count=31 & lr
	{ push(lr); }
:ldm pc, ("sp++") is Op9=0x06 & Count=31 & pc
	{ pop_pc(); }

# The same applies at least to "stm r24-r7, lr, (--sp)"
:stm lr, ("--sp") is Op9=0x07 & Rmbase=3 & Count=15 & lr
	{ push(lr); }
:ldm pc, ("sp++") is Op9=0x06 & Rmbase=3 & Count=15 & pc {
  pop_pc();
}

################################################################
# Load and Store Instructions
################################################################

with ldstreg: {
  : Rd is Rd ... { export Rd; }
  : RdLo is (Op5=0x1 & RdLo) ... { export RdLo; }
}

with basereg: {
  : Rbase  is Op8=0xe6 ; Rbase
	{ export Rbase; }
  : Rbase2 is (Op6=0x2a & Rbase2) ...
	{ export Rbase2; }
  : pc     is (Op6=0x2a & Rbase2=2 & pc) ...
	{ local tmp:4 = inst_start; export tmp; }
}

with memoffset: {
  : memoff16 is Op6=0x2a ; memoff16 { export memoff16; }
  : memoff27 is Op8=0xe6 ; memoff27 { export memoff27; }
}

with ldstmem32: {
  : (RrLo) is (Op5=0x1 & RrLo) ... { export *:4 RrLo; }
  : (Ra^memoff12) is (Op7=0x51 ; Ra) & memoff12
	{ local tmp:4 = Ra + memoff12; export *:4 tmp; }
  : (basereg^memoffset) is (Op6=0x2a | Op8=0xe6) ... & basereg & memoffset
	{ local tmp:4 = basereg + memoffset; export *:4 tmp; }
  : reloc is Op8=0xe7 ; Rbase=31 & Imm27
	[ reloc = inst_start + Imm27; ]
	{ export *:4 reloc; }
  with : ldstop=0 | ldstop=1 {
    : (Ra+Rb<<2) is Op8=0xa0 ; Ra & Rb
	{ local tmp:4 = Ra + (Rb << 2); export *:4 tmp; }
    : (--Ra) is Op8=0xa4 ; Ra
	{ Ra = Ra - 4; export *:4 Ra; }
    : (Ra++) is Op8=0xa5 ; Ra
	{ local tmp = Ra; Ra = Ra + 4; export *:4 tmp; }
  }
}
with ldstmem16: {
  : (RrLo) is (Op5=0x1 & RrLo) ... { export *:2 RrLo; }
  : (Ra^memoff12) is (Op7=0x51 ; Ra) & memoff12
	{ local tmp:4 = Ra + memoff12; export *:2 tmp; }
  : (basereg^memoffset) is (Op6=0x2a | Op8=0xe6) ... & basereg & memoffset
	{ local tmp:4 = basereg + memoffset; export *:2 tmp; }
  : reloc is Op8=0xe7 ; Rbase=31 & Imm27
	[ reloc = inst_start + Imm27; ]
	{ export *:2 reloc; }
  with : ldstop=2 | ldstop=3 | ldstop=6 {
    : (Ra+Rb<<1) is Op8=0xa0 ; Ra & Rb
	{ local tmp:4 = Ra + (Rb << 1); export *:2 tmp; }
    : (--Ra) is Op8=0xa4 ; Ra
	{ Ra = Ra - 2; export *:2 Ra; }
    : (Ra++) is Op8=0xa5 ; Ra
	{ local tmp = Ra; Ra = Ra + 2; export *:2 tmp; }
  }
}
with ldstmem8: {
  : (RrLo) is (Op5=0x1 & RrLo) ... { export *:1 RrLo; }
  : (Ra^memoff12) is (Op7=0x51 ; Ra) & memoff12
	{ local tmp:4 = Ra + memoff12; export *:1 tmp; }
  : (basereg^memoffset) is (Op6=0x2a | Op8=0xe6) ... & basereg & memoffset
	{ local tmp:4 = basereg + memoffset; export *:1 tmp; }
  : reloc is Op8=0xe7 ; Rbase=31 & Imm27
	[ reloc = inst_start + Imm27; ]
	{ export *:1 reloc; }
  with : ldstop=4 | ldstop=5 | ldstop=7 {
    : (Ra+Rb) is Op8=0xa0 ; Ra & Rb
	{ local tmp:4 = Ra + Rb; export *:1 tmp; }
    : (--Ra) is Op8=0xa4 ; Ra
	{ Ra = Ra - 1; export *:1 Ra; }
    : (Ra++) is Op8=0xa5 ; Ra
	{ local tmp = Ra; Ra = Ra + 1; export *:1 tmp; }
  }
}

with ldstinst: {
  :"ld"^ccsfx ldstreg, ldstmem32 is ldstop=0 & ccsfx & ldstreg & ldstmem32 {
    ldstreg = ldstmem32;
  }
  :"st"^ccsfx ldstreg, ldstmem32 is ldstop=1 & ccsfx & ldstreg & ldstmem32 {
    ldstmem32 = ldstreg;
  }
  :"ldh"^ccsfx ldstreg, ldstmem16 is ldstop=2 & ccsfx & ldstreg & ldstmem16 {
    ldstreg = zext(ldstmem16);
  }
  :"sth"^ccsfx ldstreg, ldstmem16 is ldstop=3 & ccsfx & ldstreg & ldstmem16 {
    ldstmem16 = ldstreg:2;
  }
  :"ldb"^ccsfx ldstreg, ldstmem8 is ldstop=4 & ccsfx & ldstreg & ldstmem8 {
    ldstreg = zext(ldstmem8);
  }
  :"stb"^ccsfx ldstreg, ldstmem8 is ldstop=5 & ccsfx & ldstreg & ldstmem8 {
    ldstmem8 = ldstreg:1;
  }
  :"ldsh"^ccsfx ldstreg, ldstmem16 is ldstop=6 & ccsfx & ldstreg & ldstmem16 {
    ldstreg = sext(ldstmem16);
  }
  :"ldsb"^ccsfx ldstreg, ldstmem8 is ldstop=7 & ccsfx & ldstreg & ldstmem8 {
    ldstreg = sext(ldstmem8);
  }
}

ldstcond: ldstinst is ldstinst & cond
	{ build cond; build ldstinst; }

:^ldstcond is ldstcond & (Op5=0x1 & LdStOpLo) ...
	[ ldstop=LdStOpLo; ] {}
:^ldstcond is ldstcond & (Op8=0xa0 & LdStOp ; argBit5=0 & argHasImm=0)
	[ ldstop=LdStOp; ] {}
:^ldstcond is ldstcond & (Op7=0x51 & LdStOp) ...
	[ ldstop=LdStOp; ] {}
:^ldstcond is ldstcond & (Op8=0xa4 & LdStOp) ...
	[ ldstop=LdStOp; ] {}
:^ldstcond is ldstcond & (Op8=0xa5 & LdStOp) ...
	[ ldstop=LdStOp; ] {}
:^ldstcond is ldstcond & (Op6=0x2a & OpAux) ...
	[ ldstop=OpAux; ] {}
:^ldstcond is ldstcond & (Op8=0xe6 & OpAux) ...
	[ ldstop=OpAux; ] {}
:^ldstcond is ldstcond & (Op8=0xe7 & OpAux ; Rbase=31)
	[ ldstop=OpAux; ] {}

# Aligned stack addressing
:ld RdLo, (spoff5) is Op7=0x02 & RdLo & spoff5 {
  RdLo = *:4 spoff5;
}
:st RdLo, (spoff5) is Op7=0x03 & RdLo & spoff5 {
  *:4 spoff5 = RdLo;
}

# Small offsets
:ld RdLo, (RrLo+off) is Op4=0x2 & RdLo & RrLo & Uoff4
	[ off = Uoff4 << 2; ] {
  RdLo = *:4 (RrLo + off);
}
:st RdLo, (RrLo+off) is Op4=0x3 & RdLo & RrLo & Uoff4
	[ off = Uoff4 << 2; ] {
  *:4 (RrLo + off) = RdLo;
}

################################################################
# Arithmetic and Logical Operations
################################################################

define pcodeop bitrev;
define pcodeop adds;
define pcodeop subs;
define pcodeop shls;
define pcodeop clipsh;
define pcodeop bitcount;

# Argument defaults
argd: Rd is Rd ... { export Rd; }
arga: argd is argd { export argd; }
argb: Rb is Op16 ; Rb { export Rb; }

# Display defaults
dispargd: argd is argd {}
disparga: arga is arga {}
dispargb: argb is argb {}
args: dispargd, dispargb is dispargd & dispargb {}

# ALU with r0-r15
@define ALU_RLO	"Op3=0x02"

# ALU with 5-bit unsigned immediate
@define ALU_IMM5 "Op3=0x03"

# ALU with 16-bit immediate
@define ALU_IMM16 "Op6=0x2c"

# ALU with 32-bit immediate
@define ALU_IMM32 "Op6=0x3a"

# Triadic ALU
@define ALU_TRIADIC "Op5=0x18"

with : $(ALU_RLO) {
  argd: RdLo is RdLo { export RdLo; }
  argb: RrLo is RrLo { export RrLo; }
}
with : $(ALU_IMM5) {
  argd: RdLo is RdLo { export RdLo; }
  argb: Imm5 is Imm5 { local tmp:4 = Imm5; export tmp; }
  dispargb: Imm5 is Imm5 {}
}
with : $(ALU_IMM16) ... {
  argb: Imm16 is Op6 ; Imm16 { local tmp:4 = Imm16; export tmp; }
  dispargb: Imm16 is Op6 ; Imm16 {}
}
with : $(ALU_IMM32) ... {
  argb: Imm32 is Op6 ; Imm32 { local tmp:4 = Imm32; export tmp; }
  dispargb: Imm32 is Op6 ; Imm32 {}
}

with : $(ALU_TRIADIC) ... {
  arga: Ra is Op5 ; Ra { export Ra; }
  with : ... argHasImm=1 {
    argb: argImm6 is Op5 ; argImm6 { local tmp:4 = argImm6; export tmp; }
    dispargb: argImm6 is Op5 ; argImm6 {}
  }
  args: dispargd, disparga, dispargb is dispargd & disparga & dispargb {}
}

with aluinst: {
  :"mov"^ccsfx argd, argb is ccsfx & aluop=0 & argd & argb {
    argd = argb;
  }
  :"cmn"^ccsfx arga, argb is ccsfx & aluop=1 & arga & argb {
    Z = arga == argb;
    N = (arga + argb) s< 0;
    C = carry(arga, argb);
    V = scarry(arga, argb);
    pack_sr();
  }
  :"add"^ccsfx args is ccsfx & aluop=2 & args & argd & arga & argb {
    argd = arga + argb;
  }
  :"bic"^ccsfx args is ccsfx & aluop=3 & args & argd & arga & argb {
    argd = arga & ~argb;
  }
  :"mul"^ccsfx args is ccsfx & aluop=4 & args & argd & arga & argb {
    argd = arga * argb;
  }
  :"eor"^ccsfx args is ccsfx & aluop=5 & args & argd & arga & argb {
    argd = arga ^ argb;
  }
  :"sub"^ccsfx args is ccsfx & aluop=6 & args & argd & arga & argb {
    argd = arga - argb;
  }
  :"and"^ccsfx args is ccsfx & aluop=7 & args & argd & arga & argb {
    argd = arga & argb;
  }
  :"not"^ccsfx argd, argb is ccsfx & aluop=8 & argd & argb {
    argd = ~argb;
  }
  :"ror"^ccsfx args is ccsfx & aluop=9 & args & argd & arga & argb {
    argd = (arga >> argb) | (arga << (32 - argb));
  }
  :"cmp"^ccsfx arga, argb is ccsfx & aluop=10 & arga & argb {
    Z = arga == argb;
    N = (arga - argb) s< 0;
    C = arga < argb;
    V = sborrow(arga, argb);
    pack_sr();
  }
  :"rsub"^ccsfx args is ccsfx & aluop=11 & args & argd & arga & argb {
    argd = argb - arga;
  }
  :"btest"^ccsfx arga, argb is ccsfx & aluop=12 & arga & argb {
    Z = (arga & (1 << argb)) == 0;
    N = 0;
    C = (arga & (1 << argb)) == 0;
    V = 0;
  }
  :"or"^ccsfx args is ccsfx & aluop=13 & args & argd & arga & argb {
    argd = arga | argb;
  }
  :"bmask"^ccsfx args is ccsfx & aluop=14 & args & argd & arga & argb {
    argd = arga & ((1 << argb) - 1);
  }
  :"max"^ccsfx args is ccsfx & aluop=15 & args & argd & arga & argb {
    local tmp:4 = arga;
    if (tmp s>= argb)
      goto <end>;
    tmp = argb;
  <end>
    argd = tmp;
  }
  :"bitset"^ccsfx args is ccsfx & aluop=16 & args & argd & arga & argb {
    argd = arga | (1 << argb);
  }
  :"min"^ccsfx args is ccsfx & aluop=17 & args & argd & arga & argb {
    local tmp:4 = arga;
    if (tmp s<= argb)
      goto <end>;
    tmp = argb;
  <end>
    argd = tmp;
  }
  :"bitclear"^ccsfx args is ccsfx & aluop=18 & args & argd & arga & argb {
    argd = arga & ~(1 << argb);
  }
  :"addscale"^ccsfx args<<1 is ccsfx & aluop=19 & args & argd & arga & argb {
    argd = arga + (argb << 1);
  }
  :"bitflip"^ccsfx args is ccsfx & aluop=20 & args & argd & arga & argb {
    argd = arga ^ (1 << argb);
  }
  :"addscale"^ccsfx args<<2 is ccsfx & aluop=21 & args & argd & arga & argb {
    argd = arga + (argb << 2);
  }
  :"addscale"^ccsfx args<<3 is ccsfx & aluop=22 & args & argd & arga & argb {
    argd = arga + (argb << 3);
  }
  :"addscale"^ccsfx args<<4 is ccsfx & aluop=23 & args & argd & arga & argb {
    argd = arga + (argb << 4);
  }
  :"signext"^ccsfx args is ccsfx & aluop=24 & args & argd & arga & argb {
    local shift:4 = 32 - argb;
    argd = (arga << shift) s>> shift;
  }
  :"neg"^ccsfx argd, argb is ccsfx & aluop=25 & args & argd & argb {
    argd = -argb;
  }
  :"lsr"^ccsfx args is ccsfx & aluop=26 & args & argd & arga & argb {
    argd = arga >> argb;
  }
  # MEASURED 2026-08-05 (`vpu-sem/recordings/hw-mon-satacc.rec`): the index of the top set bit, and
  # -1 for zero -- 0, 0x1f, 0xf, 0xffffffff for inputs 1, 0x80000000, 0x8000, 0. That is the SAME
  # operation as the vector `msb` (#57, `gen-alu.py`'s `op_msb`), which is the point: the shift loop
  # that used to be here counted leading ZEROS (it would give 31, 0, 16, 32) and was wrong at all 130
  # scalar sites. `lzcount` counts over the input's own width, so `31 - lzcount` produces the -1 with
  # no special case -- see `op_msb`'s docstring.
  #
  # The loop was also pathological to EMULATE: ~400s per probe under Ghidra's p-code emulator, and
  # measured to be independent of the operand -- a ZERO input, which takes the forward exit on the
  # first test and never executes the loop body at all, cost the same as a full 32 iterations. So the
  # cost is not the iterations. Nor is it internal branches in general: `max`/`min`/`abs`/`fabs` below
  # and the 42 predicated lane skips in `vc4-vecmem.sinc` all branch internally, run 16 lanes deep on
  # every memory probe, and replay at normal speed. What is left is the BACKWARD branch -- a loop --
  # costing even when it never loops. Root cause not isolated; the actionable rule is that a model
  # written as a loop should be assumed expensive, and there is usually a branch-free form (this one
  # is three lines shorter). Four `msb` probes made a 19-probe replay effectively non-terminating.
  :"msb"^ccsfx argd, argb is ccsfx & aluop=27 & args & argd & argb {
    local mz:4 = lzcount(argb);
    argd = 31:4 - mz;
  }
  :"shl"^ccsfx args is ccsfx & aluop=28 & args & argd & arga & argb {
    argd = arga << argb;
  }
  # MEASURED 2026-08-05 (`vpu-sem/recordings/hw-mon-brev.rec`, 12 brev probes, 16 of 16 readings
  # including the 4 from `hw-mon-satacc.rec`): `brev` is a BINARY operation, and the old body had BOTH
  # operand roles wrong. It reverses the low N bits of the FIRST SOURCE -- which in this two-operand
  # 16-bit form is `arga`, i.e. the destination register itself -- where N comes from `argb`'s low 5
  # bits, with N = 0 meaning 32. Bits above N are zeroed. So `argb` is a WIDTH, not a value to reverse.
  #
  # This is exactly the rule #94 measured for the VECTOR brev (`gen-alu.py`'s `op_brev`:
  # `bitrev_W(a) >> ((-b) & (W-1))`), and the scalar form was simply never brought into line with it.
  # Reversing the low N bits and zeroing the rest IS a full-width reversal shifted right by W-N, so the
  # data-dependent part is one variable shift and only the reversal needs writing out -- log2(32)
  # constant-mask steps, branch-free. `bitrev` above stays a pcodeop for the forms nothing has measured.
  #
  # WHY IT LOOKED ANOMALOUS FIRST TIME. `hw-mon-satacc.rec` probed sources 0x80000000, 0x00008000 and
  # 0x00000000 -- all three have low 5 bits of ZERO, so all three took the N=32 path and returned the
  # same full reversal of the destination, which read as "the source operand is ignored". The fourth
  # source was 1, giving a 1-bit reversal. Three values that collide on `& 31` and a fourth that is the
  # smallest non-zero width: the batch could not have been less informative about this field.
  :"brev"^ccsfx argd, argb is ccsfx & aluop=29 & args & argd & arga & argb {
    local bx:4 = arga;
    bx = ((bx & 0x55555555:4) << 1 ) | ((bx >> 1 ) & 0x55555555:4);
    bx = ((bx & 0x33333333:4) << 2 ) | ((bx >> 2 ) & 0x33333333:4);
    bx = ((bx & 0x0f0f0f0f:4) << 4 ) | ((bx >> 4 ) & 0x0f0f0f0f:4);
    bx = ((bx & 0x00ff00ff:4) << 8 ) | ((bx >> 8 ) & 0x00ff00ff:4);
    bx = ((bx & 0x0000ffff:4) << 16) | ((bx >> 16) & 0x0000ffff:4);
    # (0 - b) & 31 is (32 - N) & 31, which is 0 for N = 0 -- the full-reversal case, no special test.
    argd = bx >> ((0:4 - argb) & 31:4);
  }
  :"asr"^ccsfx args is ccsfx & aluop=30 & args & argd & arga & argb {
    argd = arga s>> argb;
  }
  :"abs"^ccsfx argd, argb is ccsfx & aluop=31 & argd & argb {
    local tmp:4 = argb;
    if (tmp s>= 0)
      goto <end>;
    tmp = -argb;
  <end>
    argd = tmp;
  }
  :"mulhd.ss"^ccsfx args is ccsfx & aluop=32 & args & argd & arga & argb {
    local tmp:8 = sext(arga) * sext(argb);
    argd = tmp(4);
  }
  :"mulhd.su"^ccsfx args is ccsfx & aluop=33 & args & argd & arga & argb {
    local tmp:8 = sext(arga) * zext(argb);
    argd = tmp(4);
  }
  :"mulhd.us"^ccsfx args is ccsfx & aluop=34 & args & argd & arga & argb {
    local tmp:8 = zext(arga) * sext(argb);
    argd = tmp(4);
  }
  :"mulhd.uu"^ccsfx args is ccsfx & aluop=35 & args & argd & arga & argb {
    local tmp:8 = zext(arga) * zext(argb);
    argd = tmp(4);
  }
  :"div.ss"^ccsfx args is ccsfx & aluop=36 & args & argd & arga & argb {
    argd = arga s/ argb;
  }
  :"div.su"^ccsfx args is ccsfx & aluop=37 & args & argd & arga & argb {
    local tmp:8 = sext(arga) s/ zext(argb);
    argd = tmp:4;
  }
  :"div.us"^ccsfx args is ccsfx & aluop=38 & args & argd & arga & argb {
    local tmp:8 = zext(arga) s/ sext(argb);
    argd = tmp:4;
  }
  :"div.uu"^ccsfx args is ccsfx & aluop=39 & args & argd & arga & argb {
    argd = arga / argb;
  }
  :"adds"^ccsfx args is ccsfx & aluop=40 & args & argd & arga & argb {
    argd = adds(arga, argb);
  }
  :"subs"^ccsfx args is ccsfx & aluop=41 & args & argd & arga & argb {
    argd = subs(arga, argb);
  }
  :"shls"^ccsfx args is ccsfx & aluop=42 & args & argd & arga & argb {
    argd = shls(arga, argb);
  }
  :"clipsh"^ccsfx args is ccsfx & aluop=43 & args & argd & argb {
    argd = clipsh(argb);
  }

  with : (aluop>=44 & aluop<=47) ... {
    :"addscale"^ccsfx args<<shift
	is ccsfx & args & argd & arga & argb & ScAdd ...
	[ shift = ScAdd + 5; ] {
      argd = arga + (argb << shift);
    }
    :"add"^ccsfx argd, arga, imm
	is ccsfx & argd & arga & (ScAdd ; argHasImm=1 & argImm6)
	[ imm = argImm6 << (ScAdd + 5); ] {
      argd = arga + imm;
    }
  }

  :"count"^ccsfx args is ccsfx & aluop=48 & args & argd & argb {
    argd = bitcount(argb);
  }

  with : (aluop>=49 & aluop<=56) ... {
    :"subscale"^ccsfx args<<ScSub
	is ccsfx & args & argd & arga & argb & ScSub ... {
      argd = arga + (argb << ScSub);
    }

    :"sub"^ccsfx argd, arga, imm
	is ccsfx & argd & arga & (ScSub ; argHasImm=1 & argImm6)
	[ imm = argImm6 << ScSub; ] {
      argd = arga + imm;
    }
  }
}

# Special cases for addscale immediate
with aluinst: $(ALU_IMM5) ... {
  :"add"^ccsfx argd, imm is ccsfx & aluop=22 & argd & Imm5 ...
	[ imm = Imm5 << 3; ]   { argd = argd + imm; }
}
with aluinst: $(ALU_IMM16) ... {
  :"add"^ccsfx argd, imm is ccsfx & aluop=19 & argd & (Op16 ; Imm16)
	[ imm = Imm16 << 1; ]  { argd = argd + imm; }
  :"add"^ccsfx argd, imm is ccsfx & aluop=21 & argd & (Op16 ; Imm16)
	[ imm = Imm16 << 2; ]  { argd = argd + imm; }
  :"add"^ccsfx argd, imm is ccsfx & aluop=22 & argd & (Op16 ; Imm16)
	[ imm = Imm16 << 3; ]  { argd = argd + imm; }
  :"add"^ccsfx argd, imm is ccsfx & aluop=23 & argd & (Op16 ; Imm16)
	[ imm = Imm16 << 4; ]  { argd = argd + imm; }
}
with aluinst: $(ALU_IMM32) ... {
  :"add"^ccsfx argd, imm is ccsfx & aluop=19 & argd & (Op16 ; Imm32)
	[ imm = Imm32 << 1; ]  { argd = argd + imm; }
  :"add"^ccsfx argd, imm is ccsfx & aluop=21 & argd & (Op16 ; Imm32)
	[ imm = Imm32 << 2; ]  { argd = argd + imm; }
  :"add"^ccsfx argd, imm is ccsfx & aluop=22 & argd & (Op16 ; Imm32)
	[ imm = Imm32 << 3; ]  { argd = argd + imm; }
  :"add"^ccsfx argd, imm is ccsfx & aluop=23 & argd & (Op16 ; Imm32)
	[ imm = Imm32 << 4; ]  { argd = argd + imm; }
}
with aluinst: $(ALU_TRIADIC) ; argHasImm=1 {
  :"add"^ccsfx argd, arga, imm
	is ccsfx & aluop=19 & argd & arga & (Op16 ; argImm6)
	[ imm = argImm6 << 1; ]
	{ argd = arga + imm; }
  :"add"^ccsfx argd, arga, imm
	is ccsfx & aluop=21 & argd & arga & (Op16 ; argImm6)
	[ imm = argImm6 << 2; ]
	{ argd = arga + imm; }
  :"add"^ccsfx argd, arga, imm
	is ccsfx & aluop=22 & argd & arga & (Op16 ; argImm6)
	[ imm = argImm6 << 3; ]
	{ argd = arga + imm; }
  :"add"^ccsfx argd, arga, imm
	is ccsfx & aluop=23 & argd & arga & (Op16 ; argImm6)
	[ imm = argImm6 << 4; ]
	{ argd = arga + imm; }
}

alucond: aluinst is aluinst & cond
	{ build cond; build aluinst; }

:^alucond is alucond & ($(ALU_RLO)  & AluLo) ... [ aluop = AluLo; ] {}
:^alucond is alucond & ($(ALU_IMM5) & Alu4) ... [ aluop = Alu4 << 1; ] {}
:^alucond is alucond & ($(ALU_IMM16) & Alu5) ... [ aluop = Alu5; ] {}
:^alucond is alucond & ($(ALU_IMM32) & Alu5) ... [ aluop = Alu5; ] {}
:^alucond is alucond & ($(ALU_TRIADIC) & Alu6) ... [ aluop = Alu6; ] {}

# Triadic add immediate
:add Rd, Rr, Imm16 is Op6=0x2d & Rr & Rd ; Imm16 {
  Rd = Rr + Imm16;
}
:add Rd, Rr, Imm32 is Op6=0x3b & Rr & Rd ; Imm32 {
  Rd = Rr + Imm32;
}

################################################################
# Floating Poing Operations
################################################################

define pcodeop flog2;
define pcodeop fexp2;

# Argument B for floating point instructions
fargb: Rb      is argHasImm=0 & argBit5=0 & Rb { export Rb; }
fargb: argImm6 is argHasImm=1 & argImm6 {
  local tmp:4 = argImm6;
  tmp = int2float(tmp);
  export tmp;
}

with finst: {
  :"fadd"^ccsfx Rd, Ra, fargb is ccsfx & (Alu5=0 & Rd ; Ra & fargb) {
    Rd = Ra f+ fargb;
  }
  :"fsub"^ccsfx Rd, Ra, fargb is ccsfx & (Alu5=1 & Rd ; Ra & fargb) {
    Rd = Ra f- fargb;
  }
  :"fmul"^ccsfx Rd, Ra, fargb is ccsfx & (Alu5=2 & Rd ; Ra & fargb) {
    Rd = Ra f* fargb;
  }
  :"fdiv"^ccsfx Rd, Ra, fargb is ccsfx & (Alu5=3 & Rd ; Ra & fargb) {
    Rd = Ra f/ fargb;
  }
  :"fcmp"^ccsfx Ra, fargb is ccsfx & (Alu5=4 ; Ra & fargb) {
    Z = Ra f== fargb;
    N = Ra f< fargb;	# TODO: is this right?
    C = Ra f< fargb;
    V = 0;		# TODO: what should be here?
    pack_sr();
  }
  :"fabs"^ccsfx Rd, fargb is ccsfx & (Alu5=5 & Rd ; fargb) {
    local tmp:4 = fargb;
    if (tmp f>= 0)
      goto <end>;
    tmp = f- fargb;
  <end>
    Rd = tmp;
  }
  :"frsub"^ccsfx Rd, Ra, fargb is ccsfx & (Alu5=6 & Rd ; Ra & fargb) {
    Rd = fargb f- Ra;
  }
  :"fmax"^ccsfx Rd, Ra, fargb is ccsfx & (Alu5=7 & Rd ; Ra & fargb) {
    local tmp:4 = Ra;
    if (tmp f>= fargb)
      goto <end>;
    tmp = fargb;
  <end>
    Rd = tmp;
  }
  :"frcp"^ccsfx Rd, fargb is ccsfx & (Alu5=8 & Rd ; fargb) {
    Rd = 0x3f800000 f/ fargb;
  }
  :"frsqrt"^ccsfx Rd, fargb is ccsfx & (Alu5=9 & Rd ; fargb) {
    Rd = 0x3f800000 f/ sqrt(fargb);
  }
  :"fnmul"^ccsfx Rd, Ra, fargb is ccsfx & (Alu5=10 & Rd ; Ra & fargb) {
    Rd = f- (Ra f* fargb);
  }
  :"fmin"^ccsfx Rd, Ra, fargb is ccsfx & (Alu5=11 & Rd ; Ra & fargb) {
    local tmp:4 = Ra;
    if (tmp f<= fargb)
      goto <end>;
    tmp = fargb;
  <end>
    Rd = tmp;
  }
  :"fceil"^ccsfx Rd, fargb is ccsfx & (Alu5=12 & Rd ; fargb) {
    Rd = ceil(fargb);
  }
  :"ffloor"^ccsfx Rd, fargb is ccsfx & (Alu5=13 & Rd ; fargb) {
    Rd = floor(fargb);
  }
  :"flog2"^ccsfx Rd, fargb is ccsfx & (Alu5=14 & Rd ; fargb) {
    Rd = flog2(fargb);
  }
  :"fexp2"^ccsfx Rd, fargb is ccsfx & (Alu5=15 & Rd ; fargb) {
    Rd = fexp2(fargb);
  }
  with : Alu5=16 ... {
    :"ftrunc"^ccsfx Rd, Ra, "sasl" fargb is ccsfx & (Rd ; Ra & fargb) {
      Rd = trunc(Ra f* fexp2(fargb));
    }
    :"ftrunc"^ccsfx Rd, Ra is ccsfx & (Rd ; Ra & argHasImm=1 & argImm6=0) {
      Rd = trunc(Ra);
    }
  }
  with : Alu5=17 ... {
    :"floor"^ccsfx Rd, Ra, "sasl" fargb is ccsfx & (Rd ; Ra & fargb) {
      Rd = trunc(floor(Ra f* fexp2(fargb)));
    }
    :"floor"^ccsfx Rd, Ra is ccsfx & (Rd ; Ra & argHasImm=1 & argImm6=0) {
      Rd = trunc(floor(Ra));
    }
  }
  with : Alu5=18 ... {
    :"flts"^ccsfx Rd, Ra, "sasr" fargb is ccsfx & (Rd ; Ra & fargb) {
      Rd = int2float(Ra) f/ fexp2(fargb);
    }
    :"flts"^ccsfx Rd, Ra is ccsfx & (Rd ; Ra & argHasImm=1 & argImm6=0) {
      Rd = int2float(Ra);
    }
  }
  with : Alu5=19 ... {
    :"fltu"^ccsfx Rd, Ra, "sasr" fargb is ccsfx & (Rd ; Ra & fargb) {
      local tmp:8 = zext(Ra);
      tmp = int2float(tmp);
      Rd = float2float(tmp) f/ fexp2(fargb);
    }
    :"fltu"^ccsfx Rd, Ra is ccsfx & (Rd ; Ra & argHasImm=1 & argImm6=0) {
      Rd = int2float(Ra);
    }
  }
}

:^finst is finst & cond & Op6=0x32 ...
	{ build cond; build finst; }

################################################################

# Every vector constructor below was `unimpl`, which makes the decompiler stop dead:
# "Unimplemented instruction - Truncating control flow here". Measured effect of that --
# giving `ld` alone a p-code operation took one codec function from 650 to 6,701 characters
# of decompiled output, with real parameters and locals appearing.
#
# These are `define pcodeop` black boxes, not semantics. Each one asserts only "an
# operation by this name happens here" -- deliberately, because SLEIGH has no loops, so a
# 16-lane gather whose per-lane address comes from a runtime accumulator cannot be written
# faithfully at all. What is actually known about these operations is recorded in the
# comments by the vector memory ops and in vpu-probe/findings-lookup.md; encoding them as
# p-code would require a VRF storage model this spec does not have.
#
# The win is that the decompiler now walks through vector code instead of stopping at it.

define pcodeop vld;
define pcodeop vlookupm;
define pcodeop vlookupml;
define pcodeop vmem03;
define pcodeop vst;
define pcodeop vindexwritem;
define pcodeop vindexwriteml;
define pcodeop vmem07;
define pcodeop vmemread;
define pcodeop vmemwrite;
define pcodeop vmem10;
define pcodeop vmem11;
define pcodeop vmem12;
define pcodeop vmem13;
define pcodeop vmem14;
define pcodeop vmem15;
define pcodeop vmem16;
define pcodeop vmem17;
define pcodeop vmem18;
define pcodeop vmem19;
define pcodeop vmem20;
define pcodeop vmem21;
define pcodeop vmem22;
define pcodeop vmem23;
define pcodeop vgetacc;
define pcodeop vgetaccs32;
define pcodeop vgetaccunk;
define pcodeop vgetaccs16;
define pcodeop vmem25;
define pcodeop vmem26;
define pcodeop vmem27;
define pcodeop vmem28;
define pcodeop vmem29;
define pcodeop vmem30;
define pcodeop vmem31;
define pcodeop vmov;
define pcodeop vbitplanes;
define pcodeop veven;
define pcodeop vodd;
define pcodeop vinterl;
define pcodeop vinterh;
define pcodeop vbrev;
define pcodeop vror;
define pcodeop vshl;
define pcodeop vshls;
define pcodeop vlsr;
define pcodeop vasr;
define pcodeop vsignshl;
define pcodeop vop13;
define pcodeop vsignasl;
define pcodeop vsignasls;
define pcodeop vand;
define pcodeop vor;
define pcodeop veor;
define pcodeop vbic;
define pcodeop vcount;
define pcodeop vmsb;
define pcodeop vop22;
define pcodeop vop23;
define pcodeop vmin;
define pcodeop vmax;
define pcodeop vdist;
define pcodeop vdists;
define pcodeop vclip;
define pcodeop vsign;
define pcodeop vclips;
define pcodeop vtestmag;
define pcodeop vadd;
define pcodeop vadds;
define pcodeop vaddc;
define pcodeop vaddsc;
define pcodeop vsub;
define pcodeop vsubs;
define pcodeop vsubc;
define pcodeop vsubsc;
define pcodeop vrsub;
define pcodeop vrsubs;
define pcodeop vrsubc;
define pcodeop vrsubsc;
define pcodeop vop44;
define pcodeop vop45;
define pcodeop vop46;
define pcodeop vop47;
define pcodeop vmull_ss;
define pcodeop vop48_1;
define pcodeop vmulls_ss;
define pcodeop vop49_1;
define pcodeop vmulm_ss;
define pcodeop vop50_1;
define pcodeop vmulms_ss;
define pcodeop vop51_1;
define pcodeop vmulhd_ss;
define pcodeop vmul32_ss;
define pcodeop vmulhd_su;
define pcodeop vmul32_su;
define pcodeop vmulhd_us;
define pcodeop vmul32_us;
define pcodeop vmulhd_uu;
define pcodeop vmul32_uu;
define pcodeop vmulhn_ss;
define pcodeop vop56_1;
define pcodeop vmulhn_su;
define pcodeop vop57_1;
define pcodeop vmulhn_us;
define pcodeop vop58_1;
define pcodeop vmulhn_uu;
define pcodeop vop59_1;
define pcodeop vmulht_ss;
define pcodeop vop60_1;
define pcodeop vmulht_su;
define pcodeop vop61_1;
define pcodeop vop62;
define pcodeop vop63;

# Vector Instructions
################################################################

# Va must be synthesized from VaHi and VaLo, because the
# field is not contiguous.
Va: num is VaHi & VaLo [ num = (VaHi << 4) | VaLo; ] {
  local tmp:1 = num;
  export tmp;
}

# Vector increments
vincd: is epsilon { local tmp:1 = 0; export tmp; }
vinca: is epsilon { local tmp:1 = 0; export tmp; }
vincb: is epsilon { local tmp:1 = 0; export tmp; }
with : Vopsize=1 ... {
  vincd: Vincd is Vop ; Vincd { local tmp:1 = Vincd; export tmp; }
  vinca: Vinca is Vop ; Vinca { local tmp:1 = Vinca; export tmp; }
  vincb: Vincb is Vop ; Vincb { local tmp:1 = Vincb; export tmp; }
}

# Vector co-ordinate helpers
vdhi: num is VdHi [ num = VdHi << 4; ] { local tmp:1 = num; export tmp; }
vahi: num is VaHi [ num = VaHi << 4; ] { local tmp:1 = num; export tmp; }
vbhi: num is VbHi [ num = VbHi << 4; ] { local tmp:1 = num; export tmp; }

with vbasedx: {
  :VdLo is (Vbased=0 | Vbased=4 | Vbased=6) & VdLo
	{ local tmp:1 = VdLo; export tmp; }
  : x is Vbased=1 & VdLo [ x = 16 + VdLo; ]
	{ local tmp:1 = x; export tmp; }
  : x is (Vbased=2 | Vbased=5) & VdLo [ x = 32 + VdLo; ]
	{ local tmp:1 = x; export tmp; }
  : x is Vbased=3 & VdLo [ x = 48 + VdLo; ]
	{ local tmp:1 = x; export tmp; }
}

with vbaseax: {
  :VaLo is (Vbasea=0 | Vbasea=4 | Vbasea=6) & VaLo
	{ local tmp:1 = VaLo; export tmp; }
  : x is Vbasea=1 & VaLo
	[ x = 16 + VaLo; ]
	{ local tmp:1 = x; export tmp; }
  : x is (Vbasea=2 | Vbasea=5) & VaLo
	[ x = 32 + VaLo; ]
	{ local tmp:1 = x; export tmp; }
  : x is Vbasea=3 & VaLo
	[ x = 48 + VaLo; ]
	{ local tmp:1 = x; export tmp; }
}

with vbasebx: {
  :VbLo is (Vbaseb=0 | Vbaseb=4 | Vbaseb=6) & VbLo
	{ local tmp:1 = VbLo; export tmp; }
  : x is Vbaseb=1 & VbLo
	[ x = 16 + VbLo; ]
	{ local tmp:1 = x; export tmp; }
  : x is (Vbaseb=2 | Vbaseb=5) & VbLo
	[ x = 32 + VbLo; ]
	{ local tmp:1 = x; export tmp; }
  : x is Vbaseb=3 & VbLo
	[ x = 48 + VbLo; ]
	{ local tmp:1 = x; export tmp; }
}

# Vector co-ordinates
with : (Vopsize=0 & Vdir=0) ... {
  vdy: Vd^vincd is Vd ... & vincd { local tmp:1 = Vd; export tmp; }
  vdx: Vbased is Vbased ... { local tmp:1 = Vbased; export tmp; }

  vay: Va^vinca is Va ... & vinca { local tmp:1 = Va; export tmp; }
  vax: Vbasea is Vbasea ... { local tmp:1 = Vbasea; export tmp; }

  vby: Vb^vincb is Vb ... & vincb { local tmp:1 = Vb; export tmp; }
  vbx: Vbaseb is Vbaseb ... { local tmp:1 = Vbaseb; export tmp; }
}
with : (Vopsize=0 & Vdir=1) ... {
  vdy: vdhi is vdhi ... { export vdhi; }
  vdx: vbasedx^vincd is vbasedx ... & vincd { export vbasedx; }

  vay: vahi is vahi ... { export vahi; }
  vax: vbaseax^vinca is vbaseax ... & vinca { export vbaseax; }

  vby: vbhi    is vbhi ... { export vbhi; }
  vbx: vbasebx^vincb is vbasebx ... & vincb { export vbasebx; }
}
with : Vopsize=1 ... {
  with : Vdird=0 ... {
    vdy: Vd^vincd is Vd ... & vincd { local tmp:1 = Vd; export tmp; }
    vdx: Vbased is Vbased ... { local tmp:1 = Vbased; export tmp; }
  }
  with : Vdira=0 ... {
    vay: Va^vinca is Va ... & vinca { local tmp:1 = Va; export tmp; }
    vax: Vbasea is Vbasea ... { local tmp:1 = Vbasea; export tmp; }
  }
  with : Vdirb=0 ... {
    vby: Vb^vincb is Vb ... & vincb { local tmp:1 = Vb; export tmp; }
    vbx: Vbaseb is Vbaseb ... { local tmp:1 = Vbaseb; export tmp; }
  }
  with : Vdird=1 ... {
    vdy: vdhi is vdhi ... { export vdhi; }
    vdx: vbasedx^vincd is vbasedx ... & vincd { export vbasedx; }
  }
  with : Vdira=1 ... {
    vay: vahi is vahi ... { local tmp:1 = vahi; export tmp; }
    vax: vbaseax^vinca is vbaseax ... & vinca { export vbaseax; }
  }
  with : Vdirb=1 ... {
    vby: vbhi is vbhi ... { local tmp:1 = vbhi; export tmp; }
    vbx: vbasebx^vincb is vbasebx ... & vincb { export vbasebx; }
  }
}

# Vector row/column size
vsized: 8 is epsilon { local tmp:1 = 8; export tmp; }
vsized: 16 is VseldHi=2 { local tmp:1 = 16; export tmp; }
vsized: 32 is Vseld=6 { local tmp:1 = 32; export tmp;}

vsizea: 8 is epsilon { local tmp:1 = 8; export tmp; }
vsizea: 16 is VselaHi=2 { local tmp:1 = 16; export tmp; }
vsizea: 32 is Vsela=6 { local tmp:1 = 32; export tmp;}

vsizeb: 8 is epsilon { local tmp:1 = 8; export tmp; }
vsizeb: 16 is VselbHi=2 { local tmp:1 = 16; export tmp; }
vsizeb: 32 is Vselb=6 { local tmp:1 = 32; export tmp;}

# The H/V letter, PER OPERAND. This used to be `Vdir` on all three, which is right for the 48-bit form
# -- where Vdir=(28,28) is one bit governing every operand -- and wrong for the 80-bit form, where
# Vdird(28), Vdira(18) and Vdirb(38) are independent. A mixed instruction therefore rendered every
# operand with the DESTINATION's letter: `v16add H16(40,0),H16(41,0),V16(0,0)` printed its vertical B as
# `H16(0x0,0x0)` while decoding the coordinates vertically. The coordinates were always per-operand
# correct (see the Vdira=1 / Vdirb=1 blocks above); only the letter lied.
#
# Two consequences worth recording. A reader had no way to see the difference, and any survey that
# detects the V direction from the printed text UNDERCOUNTS -- which is why the 1,928 figure in
# findings-alu.md is a floor. Both subtables are total over Vopsize, so neither can make an instruction
# undecodable the way an incomplete vpmask did.
vdirld: Vdir  is (Vopsize=0 & Vdir)  ... {}
vdirld: Vdird is (Vopsize=1 & Vdird) ... {}
vdirla: Vdir  is (Vopsize=0 & Vdir)  ... {}
vdirla: Vdira is (Vopsize=1 & Vdira) ... {}
vdirlb: Vdir  is (Vopsize=0 & Vdir)  ... {}
vdirlb: Vdirb is (Vopsize=1 & Vdirb) ... {}

# Vector row/column address
vrowd: vdirld^vsized(vdy,vdx) is vdirld ... & vsized & vdy & vdx {}
vrowd: "-" is Vseld=7 {}

vrowa: vdirla^vsizea(vay,vax) is vdirla ... & vsizea & vay & vax {}
vrowa: "-" is Vsela=7 {}

vrowb: vdirlb^vsizeb(vby,vbx) is vdirlb ... & vsizeb & vby & vbx {}
vrowb: "-" is Vselb=7 {}

# Vector offsets
vroffd:    is epsilon { local tmp:4 = 0; export tmp; }
vroffa:    is epsilon { local tmp:4 = 0; export tmp; }
vroffb:    is epsilon { local tmp:4 = 0; export tmp; }
with : Vopsize=0 & Vhasoffd=1 {
  vroffd: +VRoff is VRoff & Vhasoffd=1 { export VRoff; }
  vroffa: +VRoff is VRoff & Vhasoffa=1 { export VRoff; }
  vroffb: +VRoff is VRoff & Vhasoffb=1 { export VRoff; }
}
with : Vopsize=1 ... {
  vroffd: +VRoffd is Vop ; VRoffd    { export VRoffd; }
  vroffd:         is Vop ; VRoffd=15 { local tmp:4 = 0; export tmp; }

  vroffa: +VRoffa is Vop ; VRoffa    { export VRoffa; }
  vroffa:         is Vop ; VRoffa=15 { local tmp:4 = 0; export tmp; }

  vroffb: +VRoffb is Vop ; VRoffb    { export VRoffb; }
  vroffb:         is Vop ; VRoffb=15 { local tmp:4 = 0; export tmp; }
}

# Vector CB flag indicator
vcboffd:    is epsilon {}
vcboffa:    is epsilon {}
vcboffb:    is epsilon {}
with : Vopsize=1 ... {
  vcboffd: Vcboffd is Vop ; Vcboffd {}
  vcboffa: Vcboffa is Vop ; Vcboffa {}
  vcboffb: Vcboffb is Vop ; Vcboffb {}
}

# Vector SETF
vsetf: Vsetf48 is (Vopsize=0 & Vsetf48) ...
	{ local tmp:1 = Vsetf48; export tmp; }
vsetf: Vsetf80 is (Vopsize=1 & Vsetf80) ...
	{ local tmp:1 = Vsetf80; export tmp; }

# Vector predication
# Per-lane enable mask for the 80-bit predicated forms. Bit L enables lane L, so a body gates each
# lane on (mask >> L) & 1 and ONE constructor covers all eight conditions. The alternative -- a
# constructor per condition -- would multiply the generated ALU by seven, and it was the .sla size
# limit that forced the previous round of coverage trimming.
#
# Field values come from the display table above: 0 unconditional, 1 NV (never), then IFZ, IFNZ,
# IFN, IFNN, IFC, IFNC.
#
# Note the token CONCATENATION (`;`) rather than `&`. An 80-bit instruction is `vec48 ; vecaux`, two
# separate tokens; Vopsize is in vec48 and Vpredm in vecaux, so `&` between them fails with "Pattern
# size cannot vary". Concatenating makes the pattern a full 80 bits wide, which is also what lets it
# compose with `&` at the reference site -- the spec's own vpred80 and vflags do exactly this.
#
# COROLLARY FOR CALLERS: a constructor must NOT put vecaux fields in its own `&` group alongside
# vec48 fields; that is "Mismatched tokens when combining patterns". Constrain them through a
# concatenated helper subtable instead -- see vmem80d/vmem80a below.
# Also pins vregoff to its zero case. The 80-bit base is `vregbase + vregoff`, and the `+off` form
# has never been probed, so the offset fields are held at 0 rather than modelled: VmoffMid here,
# VmoffLo in the referring constructor's vec48 group, and VmoffHi for free because it occupies the
# SAME bits (22,28) as Vsru, which is already pinned. vreginc needs no pinning at all -- its `+=`
# cases key on Vseld=7 / Vsela=7, which a constructor naming a real widthcode cannot match.
# VRoffd=15 & Vcboffd=0 pin the RUNTIME VRF OFFSETS absent, for the same reason valu80 pins its three
# (see below) -- and this was measured, not assumed. binutils settles what 15 means:
# parse_vector_reg (binutils-vc4/cpu/vc4.opc:530) initialises `unsigned scalar_reg = 15`, accepts `+rN`
# only for regno <= 14, and ORs `scalar_reg << 12` in, so 15 is the "no offset" sentinel and 0 is a real
# `+r0`. Leaving both free meant this family MATCHED `HY(d,0)+rN` and `HY(d,0)*` encodings and modelled
# them as plain row d -- silently wrong, not merely unmodelled. Measured on start4.elf with
# vpu-sem/mem80-roff.py: 46 sites carried p-code for the wrong row or column. They are now unmodelled,
# which is the same trade valu80 already made.
#
# Safe to pin per role, per #58: no constructor reaches vmem80d with an absent destination (all 63 uses
# name VdRow/vargd; the `Vselb=7` in those patterns is the ADDRESS operand, not the destination), so
# there is no vsetfu-style case here where gas would leave the field at 0 as a don't-care.
vmem80d: is Vopsize=1 ; (Vsru=0 & Vincd=0 & VmoffMid=0 & VRoffd=15 & Vcboffd=0) { }
# The `++` twin (task #56): Vincd=1 instead of 0, and additionally UNPREDICATED. The predication and
# REP probes were all run with `++` absent, where REP is unobservable anyway, so whether a lane
# disabled by a predicate still consumes its iteration has never been measured -- Vpredm=0 keeps the
# claim inside the evidence, and the predicated `++` encodings keep their pcodeop.
vmem80dinc: is Vopsize=1 ; (Vpredm=0 & Vsru=0 & Vincd=1 & VmoffMid=0 & VRoffd=15 & Vcboffd=0) { }
# The ALU equivalent: pins the accumulator modifier and all three operand auto-increments, which are
# vecaux fields and so cannot join a constructor's vec48 `&` group.
# valu80 additionally pins the RUNTIME ROW OFFSETS absent. VRoffd/VRoffa/VRoffb encode "no offset" as
# 15; anything else makes the accessed row `Vd + rN`, chosen at run time, which these bodies do not
# model. Leaving them free meant the predicated family matched such encodings and read the wrong row,
# silently -- 116 instructions in start.elf.
#
# All three are pinned here because this subtable serves constructors that HAVE a destination row.
# vsetfu, for the flags-only forms whose destination is absent, deliberately does not pin VRoffd: with
# no destination the field is a don't-care, and gas leaves it at 0 rather than 15, so pinning it there
# excludes the very flag-setters the conformance recordings use. Getting that wrong took hw-carryflag
# from agree=8 back to agree=2/unmodelled=6 before the distinction was understood.
valu80:  is Vopsize=1 ; (Vsru=0 & Vincd=0 & Vinca=0 & Vincb=0
                         & VRoffd=15 & VRoffa=15 & VRoffb=15) { }

# The same, for a constructor whose B operand is an IMMEDIATE. There is no B row to offset, and the bits
# that would describe one are the immediate:
#
#     Vimm16Hi = (16,21)   ==   Vcboffb(16) + Vincb(17) + VRoffb(18,21)
#
# so pinning any of those three constrains the immediate's top six bits instead of pinning an addressing
# mode. valu80 pins Vincb=0 and VRoffb=15, which together confine Vimm16Hi to 0b1111xx, i.e. -4..-1 --
# admitting only huge negative immediates. Measured on start.elf: of the 1,712 80-bit sites with an
# immediate B, just 141 have VRoffb=15, so that pin alone would reject 92% of them.
#
# This is the same per-operand-role lesson as vsetfu's VRoffd above, one field further along: a pin
# belongs to the role the field plays in THIS form, not to the field's name in some other form.
# VRoffd and VRoffa are still pinned, because a destination or A row offset is real here and unmodelled.
valu80imm: is Vopsize=1 ; (Vsru=0 & Vincd=0 & Vinca=0
                           & VRoffd=15 & VRoffa=15) { }
# The A-role twin of vmem80d, pinned for the same measured reason. All 63 uses name varow/varga, so the
# A operand is always present and the offset is never a don't-care.
vmem80a: is Vopsize=1 ; (Vsru=0 & Vinca=0 & VmoffMid=0 & VRoffa=15 & Vcboffa=0) { }
# The `++` twin, for the same reason as vmem80dinc.
vmem80ainc: is Vopsize=1 ; (Vpredm=0 & Vsru=0 & Vinca=1 & VmoffMid=0 & VRoffa=15 & Vcboffa=0) { }
#
# CONSUMERS MUST USE A PER-LANE CONDITIONAL BRANCH, not a branch-free select. A disabled lane
# performs NO memory access at all (measured, findings-lookup.md), so a predicated store cannot be
# modelled as "write the old value back" -- that is still a write. The shape is
#     local eL:2 = (en >> L) & 1;  if (eL == 0) goto <sL>;  ...lane work...  <sL>
# with the label name unique per lane.
vpmask: is Vopsize=1 ; Vpredm=0 { local m:2 = 0xffff; export m; }
vpmask: is Vopsize=1 ; Vpredm=1 { local m:2 = 0x0000; export m; }
vpmask: is Vopsize=1 ; Vpredm=2 { export VFZ; }
vpmask: is Vopsize=1 ; Vpredm=3 { local m:2 = ~VFZ; export m; }
vpmask: is Vopsize=1 ; Vpredm=4 { export VFN; }
vpmask: is Vopsize=1 ; Vpredm=5 { local m:2 = ~VFN; export m; }
# IFC and IFNC. MEASURED (findings-alu.md, vpu-sem/gen-carryflag-probes.py): the carry flag is
# unsigned carry out of the top bit and IFNC is its EXACT complement, so IFC is VFC and IFNC is ~VFC.
# All six masks were predicted before the run and all six matched, with the four already-known
# conditions re-read over the same data as an apparatus check.
#
# THESE TWO WERE ABSENT UNTIL 2026-07-28, AND LEAVING THEM OUT WAS NOT THE SAFE CHOICE IT LOOKED LIKE.
# The reasoning was that an instruction carrying IFC/IFNC would "fall through to the pcodeop". It does
# not. A generated 80-bit family consumes vpmask, and sleigh's decision tree commits to that
# constructor on the pattern bits it can test and then fails to RESOLVE the vpmask operand -- it does
# not backtrack to the generic pcodeop constructor. So the instruction did not decode at all, which is
# strictly worse than a pcodeop: a linear sweep loses everything after it. Demonstrated by sweeping
# Vpredm 0..7 over one encoding (0..5 decoded, 6 and 7 did not) and confirmed by the contrast with
# Vaop=1, which no generated family claims and which therefore reached the fallback and decoded for
# all eight values.
#
# The asymmetry is worth remembering: valu80 has ONE constructor, so its pattern constrains the
# parent's and the CLRA/UACC forms correctly route to the fallback. vpmask has several, so its union
# contributes nothing the decision tree can route on.
#
# What still is not modelled is the PRODUCER. Only `add`-SETF writes VFC, because `add` is the only
# operation whose carry has been measured; after a `sub`/`mov`/load SETF, VFC holds whatever set it
# last. vpu-sem/gen-setfcarry-probes.py is the batch that closes that. This is the same shape of gap
# VFZ/VFN had before SETF was modelled -- the consumer is right, the producer set is incomplete.
vpmask: is Vopsize=1 ; Vpredm=6 { export VFC; }
vpmask: is Vopsize=1 ; Vpredm=7 { local m:2 = ~VFC; export m; }

vpred: Vpred48 is (Vopsize=0 & Vpred48) ...
	{ local tmp:1 = Vpred48; export tmp; }
vpred: Vpred80 is Vopsize=1 ; Vpred80
	{ local tmp:1 = Vpred80; export tmp; }

# Vector SRU
vsru: Vsru is Vopsize=1 ; Vsru {}
vsru:      is (Vop=0x3e & Vhasimm=0 & Vselb=7) ... {}

# Vector register addressing
vregbase: VRmbase is Vhasimm=0 & Vselb=7 ; VRmbase
	{ export VRmbase; }

vregoff: +off is VmoffLo ; VmoffMid & VmoffHi
	[ off = (VmoffHi << 9) | (VmoffMid << 7) | VmoffLo; ]
	{ local tmp:4 = off; export tmp; }
vregoff:      is VmoffLo=0 ; VmoffMid=0 & VmoffHi=0
	{ local tmp:4 = 0; export tmp; }

with vreginc: {
  :          is epsilon ... { local tmp:4 = 0; export tmp; }
  : +=VRoffd is Vseld=7 ; VRoffd { export VRoffd; }
  :          is Vseld=7 ; VRoffd=15 { local tmp:4 = 0; export tmp; }
  : +=VRoffa is Vsela=7 ; VRoffa { export VRoffa; }
  :          is Vsela=7 ; VRoffa=15 { local tmp:4 = 0; export tmp; }
}

# Immediate values
Vimm16: imm is Vhasimm=1 & Vimm16Lo ; Vimm16Hi
	[ imm = (Vimm16Hi << 10) | Vimm16Lo; ]
	{ local tmp:2 = imm; export tmp; }

# Arguments for vector operations
vargd: vrowd^vroffd^vcboffd is vrowd & vroffd & vcboffd {}
varga: vrowa^vroffa^vcboffa is vrowa & vroffa & vcboffa {}
vargb: vrowb^vroffb^vcboffb is vrowb & vroffb & vcboffb {}
with : Vopsize=0 {
  vargb: VRm is Vhasimm=0 & Vselb=7 & VRm {}
  vargb: Vimm6 is Vhasimm=1 & Vimm6 {}
}
with : Vopsize=1 ... {
  vargb: vregbase^vregoff^vreginc is vregbase & vregoff & vreginc {}
  vargb: Vimm16 is Vhasimm=1 ... & Vimm16 {}
}

# Argument 3 for vector memory operations
vmemargb: vrowb^vroffb^vcboffb is vrowb & vroffb & vcboffb {}
with : Vopsize=0 {
  vmemargb: (VRm) is Vhasimm=0 & Vselb=7 & VRm {}
  vmemargb: Vimm6 is Vhasimm=1 & Vimm6 {}
}
with : Vopsize=1 ... {
  vmemargb: (vregbase^vregoff^vreginc) is vregbase & vregoff & vreginc {}
  vmemargb: Vimm16 is Vhasimm=1 ... & Vimm16 {}
}

vflags:    is epsilon {}
with : Vopsize=0 ... {
  vflags: vsetf       is (Vhasimm=0 & Vselb=7) ... & vsetf {}
  vflags: vsetf^vpred is  Vhasimm=1            ... & vsetf & vpred {}
}
vflags: Vrep^vsetf^vpred^vsru
	is (Vopsize=1 & Vrep) ... & vsetf & vpred & vsru {}
# vflags WITHOUT Vrep, for the `++` family (#56), which CONSTRAINS Vrep to unroll by it. A field
# cannot be constrained in a constructor and also be an operand of a subtable that constructor
# names -- "Constraining currently undefined operand" -- so those constructors write the count into
# the display literally and use this instead. The rendered text is identical.
vflagsnr: vsetf^vpred^vsru
	is Vopsize=1 ... & vsetf & vpred & vsru {}



# ---------------------------------------------------------------------------------------------
# Semantics for the vector unit: what is done, how it is checked, and what is left
#
# DONE: the H-direction loads and stores with a scalar base address have real p-code, generated
# into vc4-vecmem.sinc (see @include below). All 42 of those constructors -- 3 memory widths x 7
# widthcodes x {ld,st} -- have been executed on VideoCore VI silicon and on Ghidra's p-code
# emulator from the same seeded state, and agree on all 4096 VRF bytes, 24 scalar registers, sr
# and the 2 KB memory window. The harness that does the comparing is vpu-sem/ in the rpi-hacking
# repo; it reports a constructor with no p-code as `unmodelled` rather than as passing, so what
# is verified and what is merely present stay distinguishable.
#
# Two facts that had to be measured, not inferred, and that a reader of a disassembly needs:
#
#   1. A LOAD IS NOT A BLOCK MOVE. Element i of a row lives at byte 4*i (lane-major), so a
#      transfer is 16 stride-4 assignments. `v8ld H(20,0),(r3)` puts consecutive memory bytes
#      into row bytes 0,4,8,12,...
#
#   2. THE MNEMONIC WIDTH AND THE OPERAND WIDTHCODE ARE INDEPENDENT, and the assembler encodes
#      them disagreeing quite happily. The mnemonic (Vmwidth) gives the memory element size and
#      the per-lane stride; the widthcode (Vseld/Vsela) gives the register element size and its
#      byte-in-lane. When they differ the value is converted, and the conversion is asymmetric:
#      widening from 8 bits ZERO-extends, widening from 16 bits SIGN-extends, narrowing
#      truncates. So an 8-bit element is unsigned and a 16-bit one signed -- unsurprising for a
#      video codec engine, but not guessable. Measured in all four combinations, both directions.
#
# NOT DONE, and each left as a pcodeop rather than guessed:
#
#   * VERTICAL OPERANDS SPAN 16 REGISTERS. In the H direction a row is one register: Vd is
#     6 bits, so VdRow attaches cleanly. In the V direction the row coordinate is VdHi << 4,
#     i.e. one of {0,16,32,48}, and the lane comes from VdLo/Vbased -- so a V operand addresses
#     ONE LANE ACROSS 16 ROWS. SLEIGH's attach binds a field to one register per value, not to a
#     set. Three shipped Ghidra idioms would express it: rotated `attach variables` tables on
#     duplicated same-bit fields (AARCH64instructions.sinc:1666), a recursive subtable driven by
#     context fields holding a register cursor and a stride (ARMneon.sinc:3160, the only shipped
#     place a variable stride appears), or `&Dreg + n*8` with `*[register]` indirect stores
#     (ARMneon.sinc:3075) -- the last trades away the decompiler dataflow that is the point.
#
#   * THE VECTOR-B FORMS, whose address every probe reads as the constant 40,05,00,58 no matter
#     which row is named. Unexplained, so unmodelled.
#
#   * lookupm / lookupml / indexwritem / indexwriteml. Measured (see below), but the
#     accumulator-indexed address needs per-lane VACC reads; next step, not this one.
#
#   * The ALU ops. Only their mnemonics are known -- no hardware measurement at all yet -- so
#     they stay black boxes until probed. That is the largest remaining piece.
#
# One SLEIGH trap worth recording, because it stalled an earlier attempt and the diagnosis was
# wrong for a while: `Pattern size cannot vary (missing ... ?)` here is NOT about fields crossing
# token words -- a 48-bit vector instruction is a single token. It is that a bare token field
# left OUTSIDE the ellipsis group fixes the pattern at 48 bits while the subtables beside it can
# still be 80. Put the bare fields inside the group: `(fields & VdRow & VRm) ... & vargd & ...`.
# Also, a field cannot appear in the display AND be constrained in the same constructor
# ("Constraining currently undefined operand"), so a pinned Vmwidth is written into the mnemonic
# text instead; the rendered listing is identical either way, which was verified by diffing the
# full disassembly of start.elf before and against after.
# ---------------------------------------------------------------------------------------------

# Vector memory ops
#
# The constructors below are `define pcodeop` black boxes. The H-direction ld/st subset has real
# p-code in vc4-vecmem.sinc, included after this block with strictly more specific patterns, so
# sleigh prefers it there and falls back to these everywhere else. What follows is what has been
# *measured on hardware* -- a Pi 4 (VideoCore VI) running payloads through the mailbox
# EXECUTE_CODE tag, 2026-07-26 -- so that anyone reading a disassembly here knows what the operands
# mean even though there is no p-code. Anything not verified is called out as unknown.
#
# Operand shape. The three 9-bit specifiers (D, A, B) each encode `row | (widthcode << 7)`,
# and widthcode 7 means THE OPERAND IS ABSENT, which this spec already prints as "-".
# The width/offset decoding in vbased/vbasea/vbaseb above matches hardware exactly:
#   widthcode 0..3 = 8-bit, byte-in-lane 0..3   (H(y,0) H(y,16) H(y,32) H(y,48))
#   widthcode 4,5  = 16-bit, x=0 / x=32         (HX(y,0) HX(y,32))
#   widthcode 6    = 32-bit                     (HY(y,0))
# A VRF row is 16 lanes x 4 bytes; element x lives in lane (x % 16), byte-in-lane (x / 16).
#
# The absent operand really is ignored by the hardware, not merely unprinted. For the
# ld family the A specifier -- all 9 bits plus its Vinca auto-increment -- was varied over
# 12 values (rows, byte-in-lane bits, and every widthcode) with byte-identical results.
# Symmetrically, the D specifier is inert for the st family. So the 2-operand forms below
# are right, and the bits are free rather than reserved.
#
# ld  / st            Verified: a contiguous 16-element transfer between a VRF row and
#                     memory at the B address. `v8ld H(20,0),(r3)` reads 16 consecutive
#                     bytes; `v8st` writes 16.
#
# lookupml /          A GATHER and the matching SCATTER, indexed PER LANE BY THE
# indexwriteml        ACCUMULATOR:
#
#                         address(lane) = base + accumulator(lane) * element_size
#
#                     Verified by prediction rather than just observation. With the
#                     accumulator loaded to 5 (`v32mov -,5 CLRA UACC`) and predication
#                     enabling lane 0 only, the scatter writes at base+0x05 for v8,
#                     base+0x0a for v16 and base+0x14 for v32 -- i.e. scaled by element
#                     size -- and `v32lookupml` returns the four bytes at base+0x14, the
#                     right address and the right length. acc=0/5/9 give base+0/+0x14/+0x24.
#
# lookupm /           The SAME ops with the accumulator ignored: every lane addresses
# indexwritem         `base`. So a gather broadcasts base[0] to all 16 lanes and a scatter
#                     aims all 16 writes at one address, where the last enabled lane wins.
#                     Measured directly: with acc=5, `v8indexwriteml` writes at base+5 while
#                     `v8indexwritem` writes at base+0, and likewise for the gathers.
#
#                     So the `L` suffix means "index by the accumulator" and nothing else
#                     distinguishes the pairs.
#
#                     That the no-index scatter really performs 16 writes rather than storing
#                     one element was established with the row auto-increment:
#                     `v8indexwritem H(20++,0),(r3)` consumes 16 rows and leaves the last
#                     one's byte, i.e. 16 writes collided.
#
#                     Demonstrated end to end: with the accumulator holding a per-lane ramp
#                     (0,4,8,...,60) and every lane live, `v8indexwriteml` performs 16 separate
#                     writes at stride 4 and `v8lookupml` reads 16 distinct addresses, against
#                     one byte and a broadcast when the accumulator is uniform.
#
# The accumulator     `CLRA` clears it, `UACC` accumulates into it, `vgetacc` reads it back
#                     (written `vgetacc D,-,-`, though it prints as `-,r15`).
#                       - It is PER LANE. A per-lane source gives a per-lane accumulator; an
#                         immediate gives a uniform one, which is why an early test of this
#                         looked like the accumulator could not hold a vector.
#                       - It accumulates ACROSS REP ITERATIONS: `v16mov -,1 CLRA UACC REP4`
#                         leaves 4. This matches the architecture note that CLRA applies on
#                         execution but is ignored on repetitions.
#                       - `indexwriteml` does NOT advance it, so it indexes rather than acting
#                         as a moving write pointer.
#                       - `UADD` does not load it; the ACC modifiers are not interchangeable.
#                       - `UACCH` is the SAME accumulator's HIGH HALF: it scales by 0x10000, so
#                         a value of 5 reads back as 0x50000. The `H` is "high", not
#                         "horizontal". `vgetacc H` reads the low byte of the accumulator and
#                         `vgetacc HY` the full 32-bit word -- there is one accumulator, not a
#                         bank per width.
#                       - Nothing observed clears or shifts it: a value survives 0/1/2/4/8 nops,
#                         a scalar ALU op, a scalar load, a scalar store, a read of sr, and an
#                         intervening vector op.
#
#                     Firmware's idiom is NOT a compaction, though it looks like one:
#                       v16bitplanes -,rN SETF            enable the lanes named by a mask
#                       v32mov -,0 CLRA UACC              index := 0, UNIFORM
#                       v32indexwriteml HY(8,0),(r2) IFNZ one word lands at (r2)
#                     Basic-block analysis shows all 208 sites in start4.elf are straight-line
#                     with no back edge, so there is no loop and no per-lane ramp. With a uniform
#                     zero index every enabled lane targets base+0 and exactly one word is
#                     written -- the highest enabled lane's element. The mask is built as
#                     (1 << 2*rN) - 1 and walked 16 lanes at a time (`lsr r3,0x10`), and the
#                     destination is a computed peripheral address, so this reads as a
#                     mask-selected single-element store to MMIO.
#
# Predication         Only exists in the 80-bit forms -- adding IFNZ turns a 6-byte
#                     v32indexwriteml into a 10-byte one. It gates which lanes access memory:
#                     a mask of 1 writes element 0, a mask enabling every lane leaves element
#                     15 (the last), and a mask of 0 performs NO memory access at all. Note
#                     `v16bitplanes -,imm SETF` sign-extends its 6-bit immediate, so 63 acts
#                     as all-ones rather than as lanes 0..5.
#
# vgetacc             Verified to read the accumulator into the D row. The accumulator is
#                     zero at entry, is not disturbed by ordinary vector ops, and is loaded
#                     by an `ACC`-modified op (`CLRA UACC`); `UADD` does not load it.
#
# REP (80-bit only; the 48-bit forms have no repeat field -- Vrep sits where the 48-bit
# encodings keep their scalar-register selector) iterates the instruction. The operand
# `++` forms advance a row per iteration, but the memory address does NOT advance unless
# an explicit `+=rN` is given. Note the ld/st family honours the REP count while lookupm
# and indexwritem appeared to iterate 16 times regardless of it -- unexplained.
#
# Full write-up, including the failed hypotheses and the controls that make the negative
# results meaningful: vpu-probe/findings-lookup.md in the rpi-hacking repo.
with : (Vop=0x3c | Vop=0x3e) ... {
  :v^Vmwidth^"ld" vargd, vmemargb^vflags
	is (Vmop=0 & Vmwidth) ... & vargd & vmemargb & vflags {
    vld();
  }
  :v^Vmwidth^"lookupm" vargd, vmemargb^vflags
	is (Vmop=1 & Vmwidth) ... & vargd & vmemargb & vflags {
    vlookupm();
  }
  :v^Vmwidth^"lookupml" vargd, vmemargb^vflags
	is (Vmop=2 & Vmwidth) ... & vargd & vmemargb & vflags {
    vlookupml();
  }
  :v^Vmwidth^"mem03" vargd, varga, vmemargb^vflags
	is (Vmop=3 & Vmwidth) ... & vargd & varga & vmemargb & vflags {
    vmem03();
  }
  :v^Vmwidth^"st" varga, vmemargb^vflags
	is (Vmop=4 & Vmwidth) ... & varga & vmemargb & vflags {
    vst();
  }
  :v^Vmwidth^"indexwritem" varga, vmemargb^vflags
	is (Vmop=5 & Vmwidth) ... & varga & vmemargb & vflags {
    vindexwritem();
  }
  :v^Vmwidth^"indexwriteml" varga, vmemargb^vflags
	is (Vmop=6 & Vmwidth) ... & varga & vmemargb & vflags {
    vindexwriteml();
  }
  :v^Vmwidth^"mem07" vargd, varga, vmemargb^vflags
	is (Vmop=7 & Vmwidth) ... & vargd & varga & vmemargb & vflags {
    vmem07();
  }
  :v^Vmwidth^"memread" vargd, varga, vmemargb^vflags
	is (Vmop=8 & Vmwidth) ... & vargd & varga & vmemargb & vflags {
    vmemread();
  }
  :v^Vmwidth^"memwrite" vargd, varga, vmemargb^vflags
	is (Vmop=9 & Vmwidth) ... & vargd & varga & vmemargb & vflags {
    vmemwrite();
  }
  :v^Vmwidth^"mem10" vargd, varga, vmemargb^vflags
	is (Vmop=10 & Vmwidth) ... & vargd & varga & vmemargb & vflags {
    vmem10();
  }
  :v^Vmwidth^"mem11" vargd, varga, vmemargb^vflags
	is (Vmop=11 & Vmwidth) ... & vargd & varga & vmemargb & vflags {
    vmem11();
  }
  :v^Vmwidth^"mem12" vargd, varga, vmemargb^vflags
	is (Vmop=12 & Vmwidth) ... & vargd & varga & vmemargb & vflags {
    vmem12();
  }
  :v^Vmwidth^"mem13" vargd, varga, vmemargb^vflags
	is (Vmop=13 & Vmwidth) ... & vargd & varga & vmemargb & vflags {
    vmem13();
  }
  :v^Vmwidth^"mem14" vargd, varga, vmemargb^vflags
	is (Vmop=14 & Vmwidth) ... & vargd & varga & vmemargb & vflags {
    vmem14();
  }
  :v^Vmwidth^"mem15" vargd, varga, vmemargb^vflags
	is (Vmop=15 & Vmwidth) ... & vargd & varga & vmemargb & vflags {
    vmem15();
  }
  :v^Vmwidth^"mem16" vargd, varga, vmemargb^vflags
	is (Vmop=16 & Vmwidth) ... & vargd & varga & vmemargb & vflags {
    vmem16();
  }
  :v^Vmwidth^"mem17" vargd, varga, vmemargb^vflags
	is (Vmop=17 & Vmwidth) ... & vargd & varga & vmemargb & vflags {
    vmem17();
  }
  :v^Vmwidth^"mem18" vargd, varga, vmemargb^vflags
	is (Vmop=18 & Vmwidth) ... & vargd & varga & vmemargb & vflags {
    vmem18();
  }
  :v^Vmwidth^"mem19" vargd, varga, vmemargb^vflags
	is (Vmop=19 & Vmwidth) ... & vargd & varga & vmemargb & vflags {
    vmem19();
  }
  :v^Vmwidth^"mem20" vargd, varga, vmemargb^vflags
	is (Vmop=20 & Vmwidth) ... & vargd & varga & vmemargb & vflags {
    vmem20();
  }
  :v^Vmwidth^"mem21" vargd, varga, vmemargb^vflags
	is (Vmop=21 & Vmwidth) ... & vargd & varga & vmemargb & vflags {
    vmem21();
  }
  :v^Vmwidth^"mem22" vargd, varga, vmemargb^vflags
	is (Vmop=22 & Vmwidth) ... & vargd & varga & vmemargb & vflags {
    vmem22();
  }
  :v^Vmwidth^"mem23" vargd, varga, vmemargb^vflags
	is (Vmop=23 & Vmwidth) ... & vargd & varga & vmemargb & vflags {
    vmem23();
  }
  :vgetacc vargd, varga, vmemargb^vflags is (Vmop=24 & Vmwidth=0) ...
	& vargd & varga & vmemargb & vflags {
    vgetacc();
  }
  :vgetaccs32 vargd, varga, vmemargb^vflags
	is (Vmop=24 & Vmwidth=1) ... & vargd & varga & vmemargb & vflags {
    vgetaccs32();
  }
  :vgetaccunk vargd, varga, vmemargb^vflags
	is (Vmop=24 & Vmwidth=2) ... & vargd & varga & vmemargb & vflags {
    vgetaccunk();
  }
  :vgetaccs16 vargd, varga, vmemargb^vflags
	is (Vmop=24 & Vmwidth=3) ... & vargd & varga & vmemargb & vflags {
    vgetaccs16();
  }
  :v^Vmwidth^"mem25" vargd, varga, vmemargb^vflags
	is (Vmop=25 & Vmwidth) ... & vargd & varga & vmemargb & vflags {
    vmem25();
  }
  :v^Vmwidth^"mem26" vargd, varga, vmemargb^vflags
	is (Vmop=26 & Vmwidth) ... & vargd & varga & vmemargb & vflags {
    vmem26();
  }
  :v^Vmwidth^"mem27" vargd, varga, vmemargb^vflags
	is (Vmop=27 & Vmwidth) ... & vargd & varga & vmemargb & vflags {
    vmem27();
  }
  :v^Vmwidth^"mem28" vargd, varga, vmemargb^vflags
	is (Vmop=28 & Vmwidth) ... & vargd & varga & vmemargb & vflags {
    vmem28();
  }
  :v^Vmwidth^"mem29" vargd, varga, vmemargb^vflags
	is (Vmop=29 & Vmwidth) ... & vargd & varga & vmemargb & vflags {
    vmem29();
  }
  :v^Vmwidth^"mem30" vargd, varga, vmemargb^vflags
	is (Vmop=30 & Vmwidth) ... & vargd & varga & vmemargb & vflags {
    vmem30();
  }
  :v^Vmwidth^"mem31" vargd, varga, vmemargb^vflags
	is (Vmop=31 & Vmwidth) ... & vargd & varga & vmemargb & vflags {
    vmem31();
  }
}

# Real p-code for the subset of the above that has been measured AND can be expressed: the
# H-direction loads and stores with a scalar base. These constructors are strictly more specific
# than the pcodeop ones above, so sleigh prefers them and everything else keeps its black box.
# Generated -- see vpu-sem/gen-vecmem.py for the measurements and the omissions.
@include "vc4-vecmem.sinc"

# Real p-code for the vector ALU operations identified from hardware -- 16-bit width with all
# three operands at widthcode 4, the shape that was probed. Generated; see vpu-sem/gen-alu.py.
@include "vc4-vecalu.sinc"

# Vector ALU ops
with : (Vop=0x3d | Vop=0x3f) ... {
  :v^Vawidth^"mov" vargd, vargb^vflags
	is (Vaop=0 & Vawidth) ... & vargd & vargb & vflags {
    vmov();
  }
  :v^Vawidth^"bitplanes" vargd, vargb^vflags
	is (Vaop=1 & Vawidth) ... & vargd & vargb & vflags {
    vbitplanes();
  }
  :v^Vawidth^"even" vargd, varga, vargb^vflags
	is (Vaop=2 & Vawidth) ... & vargd & varga & vargb & vflags {
    veven();
  }
  :v^Vawidth^"odd" vargd, varga, vargb^vflags
	is (Vaop=3 & Vawidth) ... & vargd & varga & vargb & vflags {
    vodd();
  }
  :v^Vawidth^"interl" vargd, varga, vargb^vflags
	is (Vaop=4 & Vawidth) ... & vargd & varga & vargb & vflags {
    vinterl();
  }
  :v^Vawidth^"interh" vargd, varga, vargb^vflags
	is (Vaop=5 & Vawidth) ... & vargd & varga & vargb & vflags {
    vinterh();
  }
  :v^Vawidth^"brev" vargd, varga, vargb^vflags
	is (Vaop=6 & Vawidth) ... & vargd & varga & vargb & vflags {
    vbrev();
  }
  :v^Vawidth^"ror" vargd, varga, vargb^vflags
	is (Vaop=7 & Vawidth) ... & vargd & varga & vargb & vflags {
    vror();
  }
  :v^Vawidth^"shl" vargd, varga, vargb^vflags
	is (Vaop=8 & Vawidth) ... & vargd & varga & vargb & vflags {
    vshl();
  }
  :v^Vawidth^"shls" vargd, varga, vargb^vflags
	is (Vaop=9 & Vawidth) ... & vargd & varga & vargb & vflags {
    vshls();
  }
  :v^Vawidth^"lsr" vargd, varga, vargb^vflags
	is (Vaop=10 & Vawidth) ... & vargd & varga & vargb & vflags {
    vlsr();
  }
  :v^Vawidth^"asr" vargd, varga, vargb^vflags
	is (Vaop=11 & Vawidth) ... & vargd & varga & vargb & vflags {
    vasr();
  }
  :v^Vawidth^"signshl" vargd, varga, vargb^vflags
	is (Vaop=12 & Vawidth) ... & vargd & varga & vargb & vflags {
    vsignshl();
  }
  :v^Vawidth^"op13" vargd, varga, vargb^vflags
	is (Vaop=13 & Vawidth) ... & vargd & varga & vargb & vflags {
    vop13();
  }
  :v^Vawidth^"signasl" vargd, varga, vargb^vflags
	is (Vaop=14 & Vawidth) ... & vargd & varga & vargb & vflags {
    vsignasl();
  }
  :v^Vawidth^"signasls" vargd, varga, vargb^vflags
	is (Vaop=15 & Vawidth) ... & vargd & varga & vargb & vflags {
    vsignasls();
  }
  :v^Vawidth^"and" vargd, varga, vargb^vflags
	is (Vaop=16 & Vawidth) ... & vargd & varga & vargb & vflags {
    vand();
  }
  :v^Vawidth^"or" vargd, varga, vargb^vflags
	is (Vaop=17 & Vawidth) ... & vargd & varga & vargb & vflags {
    vor();
  }
  :v^Vawidth^"eor" vargd, varga, vargb^vflags
	is (Vaop=18 & Vawidth) ... & vargd & varga & vargb & vflags {
    veor();
  }
  :v^Vawidth^"bic" vargd, varga, vargb^vflags
	is (Vaop=19 & Vawidth) ... & vargd & varga & vargb & vflags {
    vbic();
  }
  :v^Vawidth^"count" vargd, varga, vargb^vflags
	is (Vaop=20 & Vawidth) ... & vargd & varga & vargb & vflags {
    vcount();
  }
  :v^Vawidth^"msb" vargd, varga, vargb^vflags
	is (Vaop=21 & Vawidth) ... & vargd & varga & vargb & vflags {
    vmsb();
  }
  :v^Vawidth^"op22" vargd, varga, vargb^vflags
	is (Vaop=22 & Vawidth) ... & vargd & varga & vargb & vflags {
    vop22();
  }
  :v^Vawidth^"op23" vargd, varga, vargb^vflags
	is (Vaop=23 & Vawidth) ... & vargd & varga & vargb & vflags {
    vop23();
  }
  :v^Vawidth^"min" vargd, varga, vargb^vflags
	is (Vaop=24 & Vawidth) ... & vargd & varga & vargb & vflags {
    vmin();
  }
  :v^Vawidth^"max" vargd, varga, vargb^vflags
	is (Vaop=25 & Vawidth) ... & vargd & varga & vargb & vflags {
    vmax();
  }
  :v^Vawidth^"dist" vargd, varga, vargb^vflags
	is (Vaop=26 & Vawidth) ... & vargd & varga & vargb & vflags {
    vdist();
  }
  :v^Vawidth^"dists" vargd, varga, vargb^vflags
	is (Vaop=27 & Vawidth) ... & vargd & varga & vargb & vflags {
    vdists();
  }
  :v^Vawidth^"clip" vargd, varga, vargb^vflags
	is (Vaop=28 & Vawidth) ... & vargd & varga & vargb & vflags {
    vclip();
  }
  :v^Vawidth^"sign" vargd, varga, vargb^vflags
	is (Vaop=29 & Vawidth) ... & vargd & varga & vargb & vflags {
    vsign();
  }
  :v^Vawidth^"clips" vargd, varga, vargb^vflags
	is (Vaop=30 & Vawidth) ... & vargd & varga & vargb & vflags {
    vclips();
  }
  :v^Vawidth^"testmag" vargd, varga, vargb^vflags
	is (Vaop=31 & Vawidth) ... & vargd & varga & vargb & vflags {
