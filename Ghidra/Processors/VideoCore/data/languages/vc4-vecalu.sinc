    vln427(VdRow[192,32], varow[96,32], en, 6:2);
    vln427(VdRow[224,32], bscalar, en, 7:2);
    vln427(VdRow[256,32], varow[128,32], en, 8:2);
    vln427(VdRow[288,32], bscalar, en, 9:2);
    vln427(VdRow[320,32], varow[160,32], en, 10:2);
    vln427(VdRow[352,32], bscalar, en, 11:2);
    vln427(VdRow[384,32], varow[192,32], en, 12:2);
    vln427(VdRow[416,32], bscalar, en, 13:2);
    vln427(VdRow[448,32], varow[224,32], en, 14:2);
    vln427(VdRow[480,32], bscalar, en, 15:2);
  }

  # v32odd
  :v32odd vargd, varga, vargb^vflags
	is (Vaop=3 & Vawidth=1 & Vdir=0 & Vseld=6 & Vsetf80=0 & VdRow & Vrep=0 & Vselb=7 & Vhasimm=0 & VRm & Vsela=6 & Vhasoffa=0 & varow) ...
	   & vargd & varga & vargb & vflags & vpmask & valu80 {
    local en:2 = vpmask;
    local bscalar:4 = VRm;
    vln427(VdRow[0,32], varow[32,32], en, 0:2);
    vln427(VdRow[32,32], varow[96,32], en, 1:2);
    vln427(VdRow[64,32], varow[160,32], en, 2:2);
    vln427(VdRow[96,32], varow[224,32], en, 3:2);
    vln427(VdRow[128,32], varow[288,32], en, 4:2);
    vln427(VdRow[160,32], varow[352,32], en, 5:2);
    vln427(VdRow[192,32], varow[416,32], en, 6:2);
    vln427(VdRow[224,32], varow[480,32], en, 7:2);
    vln427(VdRow[256,32], bscalar, en, 8:2);
    vln427(VdRow[288,32], bscalar, en, 9:2);
    vln427(VdRow[320,32], bscalar, en, 10:2);
    vln427(VdRow[352,32], bscalar, en, 11:2);
    vln427(VdRow[384,32], bscalar, en, 12:2);
    vln427(VdRow[416,32], bscalar, en, 13:2);
    vln427(VdRow[448,32], bscalar, en, 14:2);
    vln427(VdRow[480,32], bscalar, en, 15:2);
  }
}
